def agrees : Nat × Nat × Option Nat → Bool
  | (x, y, r) =>
    let s : F32 := FloatV.add (FloatV.ofPat x) (FloatV.ofPat y)
    match r with
    | none => s.isNaN
    | some p => s.pat == p

#eval cases.length
#eval (cases.filter (fun c => !agrees c)).length
