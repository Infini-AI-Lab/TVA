def Kernels.AttnFwd.absA : ℚ :=
1 / 2 ^ 37
def Kernels.AttnFwd.kapA : ℚ :=
1 / 2 ^ 29
def Kernels.AttnFwd.absQ0 : ℕ → ℕ → ℚ → ℚ :=
fun D N X =>
  Kernels.AttnFwd.facc D N X * (↑(Kernels.AttnFwd.nblocks N) * Kernels.AttnFwd.absA) /
      (Kernels.AttnFwd.wlow D X * Kernels.AttnFwd.denQ D N X) +
    Kernels.AttnFwd.facc D N X * Kernels.AttnFwd.kapA / Kernels.AttnFwd.denQ D N X
def Kernels.AttnFwd.tolF : ℕ → ℕ → ℚ → ℚ :=
fun D N X =>
  Kernels.AttnFwd.absQ0 D N X * (1 + Kernels.AttnFwd.lastRel) + 1 / 2 ^ 11 * (1 / 2 ^ 148) + 1 / 2 ^ 25 + 1 / 2 ^ 148
def Kernels.AttnFwd.kapAr : ℝ :=
1 / 2 ^ 29
def Kernels.AttnFwd.absAr : ℝ :=
1 / 2 ^ 37
def Kernels.AttnFwd.AInv : Kernels.AttnFwd.RowCtx → (ℕ → ℝ) → ℕ → TVA.F32 → TVA.F32 → Prop :=
fun R ve t m a =>
  TVA.FloatV.isFinite a = Bool.true ∧
    |TVA.FloatV.toReal a - Kernels.AttnFwd.psum R.al t fun j => Kernels.AttnFwd.wt R (TVA.FloatV.toReal m) j * ve j| ≤
      ((Kernels.AttnFwd.ffac R (Kernels.AttnFwd.psi16r R.E) Kernels.AttnFwd.stepAr t (TVA.FloatV.toReal m) - 1) *
          Kernels.AttnFwd.psum R.al t fun j => Kernels.AttnFwd.wt R (TVA.FloatV.toReal m) j * |ve j|) +
        Kernels.AttnFwd.ffac R (Kernels.AttnFwd.psi16r R.E) Kernels.AttnFwd.stepAr t (TVA.FloatV.toReal m) *
          ((Kernels.AttnFwd.om0 * Kernels.AttnFwd.psum R.al t fun j => |ve j|) +
              Kernels.AttnFwd.kapAr * Kernels.AttnFwd.psum R.al t (Kernels.AttnFwd.wt R (TVA.FloatV.toReal m)) +
            ↑t * Kernels.AttnFwd.absAr)
'Kernels.AttnFwd.main' depends on axioms: [propext, Classical.choice, Quot.sound]
