def Kernels.AttnFwd.maybe_make_tensor_desc : Kernels.AttnFwd.DescArg →
  List TVA.I32 → List TVA.I64 → TVA.Shape → TVA.Prog (TVA.TensorDesc TVA.DType.f16) :=
fun desc_or_ptr shape strides block_shape =>
  match desc_or_ptr with
  | Kernels.AttnFwd.DescArg.host D => Pure.pure D
  | Kernels.AttnFwd.DescArg.ptr p => TVA.tl.make_tensor_descriptor p shape strides block_shape
def Kernels.AttnFwd.cfg16 : TVA.DotCfg :=
{ a := TVA.DType.f16, b := TVA.DType.f16, acc := TVA.DType.f32 }
def Kernels.AttnFwd.attn_fwd_inner : {BLOCK_M HEAD_DIM BLOCK_N : ℕ} →
  TVA.Tensor [BLOCK_M, HEAD_DIM] TVA.F32 →
    TVA.Tensor [BLOCK_M] TVA.F32 →
      TVA.Tensor [BLOCK_M] TVA.F32 →
        TVA.Tensor [BLOCK_M, HEAD_DIM] TVA.F16 →
          TVA.TensorDesc TVA.DType.f16 →
            TVA.TensorDesc TVA.DType.f16 →
              TVA.I32 →
                TVA.I32 →
                  TVA.F32 →
                    ℕ →
                      TVA.Tensor [BLOCK_M] TVA.I32 →
                        TVA.Tensor [BLOCK_N] TVA.I32 →
                          TVA.I32 →
                            TVA.Prog
                              (TVA.Tensor [BLOCK_M, HEAD_DIM] TVA.F32 ×
                                TVA.Tensor [BLOCK_M] TVA.F32 × TVA.Tensor [BLOCK_M] TVA.F32) :=
fun {BLOCK_M HEAD_DIM BLOCK_N} acc l_i m_i q desc_k desc_v offset_y start_m qk_scale STAGE offs_m offs_n N_CTX =>
  have __do_jp := fun __x =>
    match __x with
    | (lo, hi) =>
      have offsetk_y := offset_y + lo;
      have offsetv_y := offset_y + lo;
      do
      let __x ←
        TVA.tl.forRange lo hi (TVA.IntV.ofNat BLOCK_N) (acc, l_i, m_i, offsetk_y, offsetv_y) fun start_n x =>
            match x with
            | (acc, l_i, m_i, offsetk_y, offsetv_y) => do
              let __do_lift ← TVA.tl.desc_load desc_k [offsetk_y, TVA.IntV.ofInt 0]
              have k : TVA.Tensor [HEAD_DIM, BLOCK_N] TVA.F16 := __do_lift.trans
              let qk ← TVA.tl.dot Kernels.AttnFwd.cfg16 q k (TVA.tl.zeros [BLOCK_M, BLOCK_N] TVA.DType.f32)
              have __do_jp :
                TVA.Tensor [BLOCK_M, BLOCK_N] (TVA.FloatV TVA.Math.Float.Format.binary32) ×
                    TVA.Tensor [BLOCK_M] (TVA.FloatV TVA.Math.Float.Format.binary32) →
                  TVA.Prog
                    (TVA.Tensor [BLOCK_M, HEAD_DIM] TVA.F32 ×
                      TVA.Tensor [BLOCK_M] TVA.F32 × TVA.Tensor [BLOCK_M] TVA.F32 × TVA.I32 × TVA.I32) :=
                fun __x =>
                match __x with
                | (qk, m_ij) => do
                  let p ← TVA.tl.exp2 qk
                  let __do_lift ← TVA.tl.sub m_i m_ij
                  let alpha ← TVA.tl.exp2 __do_lift
                  let l_ij ← TVA.tl.sum1 p
                  let acc ← TVA.tl.mul acc (alpha.col HEAD_DIM)
                  let v ← TVA.tl.desc_load desc_v [offsetv_y, TVA.IntV.ofInt 0]
                  let p ← TVA.tl.cvt p
                  let acc ← TVA.tl.dot Kernels.AttnFwd.cfg16 p v acc
                  let l_i ← TVA.tl.mul_add l_i alpha l_ij
                  have m_i : TVA.Tensor [BLOCK_M] (TVA.FloatV TVA.Math.Float.Format.binary32) := m_ij
                  have offsetk_y : TVA.I32 := offsetk_y + TVA.IntV.ofNat BLOCK_N
                  have offsetv_y : TVA.I32 := offsetv_y + TVA.IntV.ofNat BLOCK_N
                  Pure.pure (acc, l_i, m_i, offsetk_y, offsetv_y)
              if STAGE = 2 then
                  have mask := (start_n + offs_n.row BLOCK_M).le (offs_m.col BLOCK_N);
                  do
                  let qk ←
                    TVA.tl.mul_add qk (TVA.bc qk_scale)
                        (mask.where_ (TVA.bc (TVA.FloatV.ofPat 0).litF32)
                          (TVA.bc (TVA.FloatV.ofPat 13920209183539462144).litF32))
                  let __do_lift ← TVA.tl.max1 Bool.true qk
                  let m_ij ← TVA.tl.maximum m_i __do_lift
                  let qk ← TVA.tl.sub qk (m_ij.col BLOCK_N)
                  let __x ← Pure.pure (qk, m_ij)
                  __do_jp __x
                else do
                  let __do_lift ← TVA.tl.max1 Bool.true qk
                  let __do_lift ← TVA.tl.mul __do_lift (TVA.bc qk_scale)
                  let m_ij ← TVA.tl.maximum m_i __do_lift
                  let __do_lift ← TVA.tl.mul qk (TVA.bc qk_scale)
                  let qk ← TVA.tl.subc __do_lift (m_ij.col BLOCK_N)
                  let __x ← Pure.pure (qk, m_ij)
                  __do_jp __x
      match __x with
        | (acc, l_i, m_i, _offsetk_y, _offsetv_y) => Pure.pure (acc, l_i, m_i);
  if STAGE = 1 then do
    let __x ← Pure.pure (TVA.IntV.ofInt 0, start_m * TVA.IntV.ofNat BLOCK_M)
    __do_jp __x
  else
    if STAGE = 2 then
      have lo := start_m * TVA.IntV.ofNat BLOCK_M;
      have hi := (start_m + TVA.IntV.ofInt 1) * TVA.IntV.ofNat BLOCK_M;
      do
      let lo ← TVA.tl.multiple_of1 lo BLOCK_M
      let __x ← Pure.pure (lo, hi)
      __do_jp __x
    else do
      let __x ← Pure.pure (TVA.IntV.ofInt 0, N_CTX)
      __do_jp __x
def Kernels.AttnFwd.attn_fwd : TVA.F32 →
  TVA.Ptr TVA.DType.f32 →
    TVA.I32 →
      TVA.I32 →
        Kernels.AttnFwd.DescArg →
          Kernels.AttnFwd.DescArg →
            Kernels.AttnFwd.DescArg → Kernels.AttnFwd.DescArg → TVA.I32 → ℕ → ℕ → ℕ → ℕ → TVA.Kernel :=
fun sm_scale M Z H desc_q desc_k desc_v desc_o N_CTX HEAD_DIM BLOCK_M BLOCK_N STAGE =>
  {
    body := fun ctx =>
      have start_m := TVA.tl.program_id ctx 0;
      have off_hz := TVA.tl.program_id ctx 1;
      do
      let __do_lift ← TVA.tl.idiv (TVA.Tensor.scalar off_hz) (TVA.Tensor.scalar H)
      have off_z : TVA.IntV Bool.true 32 := __do_lift.item
      let __do_lift ← TVA.tl.irem (TVA.Tensor.scalar off_hz) (TVA.Tensor.scalar H)
      have off_h : TVA.IntV Bool.true 32 := __do_lift.item
      have y_dim : TVA.I32 := Z * H * N_CTX
      let desc_q ←
        Kernels.AttnFwd.maybe_make_tensor_desc desc_q [y_dim, TVA.IntV.ofNat HEAD_DIM]
            [TVA.IntV.ofNat HEAD_DIM, TVA.IntV.ofNat 1] [BLOCK_M, HEAD_DIM]
      let desc_v ←
        Kernels.AttnFwd.maybe_make_tensor_desc desc_v [y_dim, TVA.IntV.ofNat HEAD_DIM]
            [TVA.IntV.ofNat HEAD_DIM, TVA.IntV.ofNat 1] [BLOCK_N, HEAD_DIM]
      let desc_k ←
        Kernels.AttnFwd.maybe_make_tensor_desc desc_k [y_dim, TVA.IntV.ofNat HEAD_DIM]
            [TVA.IntV.ofNat HEAD_DIM, TVA.IntV.ofNat 1] [BLOCK_N, HEAD_DIM]
      let desc_o ←
        Kernels.AttnFwd.maybe_make_tensor_desc desc_o [y_dim, TVA.IntV.ofNat HEAD_DIM]
            [TVA.IntV.ofNat HEAD_DIM, TVA.IntV.ofNat 1] [BLOCK_M, HEAD_DIM]
      have offset_y : TVA.IntV Bool.true 32 := off_z * (N_CTX * H) + off_h * N_CTX
      have qo_offset_y : TVA.IntV Bool.true 32 := offset_y + start_m * TVA.IntV.ofNat BLOCK_M
      have offs_m : TVA.Tensor [BLOCK_M - 0] (TVA.IntV Bool.true 32) :=
        start_m * TVA.IntV.ofNat BLOCK_M + TVA.tl.arange 0 BLOCK_M
      have offs_n : TVA.Tensor [BLOCK_N - 0] TVA.I32 := TVA.tl.arange 0 BLOCK_N
      let m_i ← TVA.tl.sub (TVA.tl.zeros [BLOCK_M] TVA.DType.f32) (TVA.bc (TVA.FloatV.ofPat 9218868437227405312).litF32)
      let l_i ← TVA.tl.add (TVA.tl.zeros [BLOCK_M] TVA.DType.f32) (TVA.bc (TVA.FloatV.ofPat 4607182418800017408).litF32)
      have acc : TVA.Tensor [BLOCK_M, HEAD_DIM] TVA.DType.f32.Val := TVA.tl.zeros [BLOCK_M, HEAD_DIM] TVA.DType.f32
      have qk_scale : TVA.F32 := sm_scale
      let __do_lift ←
        TVA.tl.mul (TVA.Tensor.scalar qk_scale) (TVA.Tensor.scalar (TVA.FloatV.ofPat 4609176140017200175).litF32)
      have qk_scale : TVA.FloatV TVA.Math.Float.Format.binary32 := __do_lift.item
      let q ← TVA.tl.desc_load desc_q [qo_offset_y, TVA.IntV.ofInt 0]
      have __do_jp :
        TVA.Tensor [BLOCK_M, HEAD_DIM] TVA.F32 × TVA.Tensor [BLOCK_M] TVA.F32 × TVA.Tensor [BLOCK_M] TVA.F32 →
          TVA.Prog Unit :=
        fun __x =>
        match __x with
        | (acc, l_i, m_i) =>
          have __do_jp := fun __x =>
            match __x with
            | (acc, l_i, m_i) => do
              let __do_lift ← TVA.tl.log2 l_i
              let m_i ← TVA.tl.add m_i __do_lift
              let acc ← TVA.tl.div acc (l_i.col HEAD_DIM)
              have m_ptrs : TVA.Tensor [BLOCK_M - 0] (TVA.Ptr TVA.DType.f32) := M + off_hz * N_CTX + offs_m
              TVA.tl.store m_ptrs m_i
              let o16 ← TVA.tl.cvt acc
              TVA.tl.desc_store desc_o [qo_offset_y, TVA.IntV.ofInt 0] o16;
          if STAGE &&& 2 ≠ 0 then do
            let __x ←
              Kernels.AttnFwd.attn_fwd_inner acc l_i m_i q desc_k desc_v offset_y start_m qk_scale 2 offs_m offs_n N_CTX
            __do_jp __x
          else do
            let __x ← Pure.pure (acc, l_i, m_i)
            __do_jp __x
      if STAGE &&& 1 ≠ 0 then do
          let __x ←
            Kernels.AttnFwd.attn_fwd_inner acc l_i m_i q desc_k desc_v offset_y start_m qk_scale (4 - STAGE) offs_m
                offs_n N_CTX
          __do_jp __x
        else do
          let __x ← Pure.pure (acc, l_i, m_i)
          __do_jp __x }
def Kernels.AttnFwd.model : Kernels.AttnFwd.Inst → TVA.Kernel :=
fun d =>
  Kernels.AttnFwd.attn_fwd (TVA.FloatV.hostF32 d.sm_scale) (d.M.ptr 0) (TVA.IntV.ofNat d.Z) (TVA.IntV.ofNat d.H)
    (Kernels.AttnFwd.descArg d d.q 128) (Kernels.AttnFwd.descArg d d.k 64) (Kernels.AttnFwd.descArg d d.v 64)
    (Kernels.AttnFwd.descArg d d.o 128) (TVA.IntV.ofNat d.N_CTX) d.HEAD_DIM 128 64
    (if d.causal = Bool.true then 3 else 1)
def Kernels.AttnFwd.launch : Kernels.AttnFwd.Inst → TVA.Launch :=
fun d =>
  { grid := ![(d.N_CTX + 127) / 128, d.Z * d.H, 1],
    blocks := [[128], [64], [128, 1], [1, 64], [128, 64], [d.HEAD_DIM, 64], [64, d.HEAD_DIM], [128, d.HEAD_DIM]] }
def Kernels.AttnFwd.descArg : Kernels.AttnFwd.Inst → TVA.Buf TVA.DType.f16 → ℕ → Kernels.AttnFwd.DescArg :=
fun d b BM =>
  if d.warp_specialize = Bool.true then Kernels.AttnFwd.DescArg.ptr (b.ptr 0)
  else
    Kernels.AttnFwd.DescArg.host
      { base := b.ptr 0, shape := [Kernels.AttnFwd.rows d, d.HEAD_DIM], strides := [d.HEAD_DIM, 1],
        block := [BM, d.HEAD_DIM] }
def Kernels.AttnFwd.below : ℕ → Set ℕ :=
fun n => {i | i < n}
structure Kernels.AttnFwd.Inst.ok (d : Kernels.AttnFwd.Inst) : Prop
number of parameters: 1
fields:
  Kernels.AttnFwd.Inst.ok.head_dim : d.HEAD_DIM = 64 ∨ d.HEAD_DIM = 128 ∨ d.HEAD_DIM = 256
  Kernels.AttnFwd.Inst.ok.n_mul : 0 < d.N_CTX ∧ d.N_CTX % 128 = 0
  Kernels.AttnFwd.Inst.ok.n_le : d.N_CTX ≤ 2 ^ 16
  Kernels.AttnFwd.Inst.ok.zh_pos : 0 < d.Z ∧ 0 < d.H
  Kernels.AttnFwd.Inst.ok.zh_lt : d.Z * d.H < 2 ^ 16
  Kernels.AttnFwd.Inst.ok.rows_lt : Kernels.AttnFwd.rows d < 2 ^ 31
  Kernels.AttnFwd.Inst.ok.scale : TVA.FloatV.isFinite d.sm_scale = Bool.true ∧
      1 / 2 ^ 64 ≤ TVA.FloatV.toRat d.sm_scale ∧ TVA.FloatV.toRat d.sm_scale ≤ 2 ^ 64
  Kernels.AttnFwd.Inst.ok.lens : Kernels.AttnFwd.rows d * d.HEAD_DIM ≤ d.q.len ∧
      Kernels.AttnFwd.rows d * d.HEAD_DIM ≤ d.k.len ∧
        Kernels.AttnFwd.rows d * d.HEAD_DIM ≤ d.v.len ∧
          Kernels.AttnFwd.rows d * d.HEAD_DIM ≤ d.o.len ∧ Kernels.AttnFwd.rows d ≤ d.M.len
  Kernels.AttnFwd.Inst.ok.align : d.q.base % 16 = 0 ∧ d.k.base % 16 = 0 ∧ d.v.base % 16 = 0 ∧ d.o.base % 16 = 0
  Kernels.AttnFwd.Inst.ok.disj : Disjoint (d.o.elems (Kernels.AttnFwd.below (Kernels.AttnFwd.rows d * d.HEAD_DIM)))
        (d.q.elems (Kernels.AttnFwd.below (Kernels.AttnFwd.rows d * d.HEAD_DIM))) ∧
      Disjoint (d.o.elems (Kernels.AttnFwd.below (Kernels.AttnFwd.rows d * d.HEAD_DIM)))
          (d.k.elems (Kernels.AttnFwd.below (Kernels.AttnFwd.rows d * d.HEAD_DIM))) ∧
        Disjoint (d.o.elems (Kernels.AttnFwd.below (Kernels.AttnFwd.rows d * d.HEAD_DIM)))
            (d.v.elems (Kernels.AttnFwd.below (Kernels.AttnFwd.rows d * d.HEAD_DIM))) ∧
          Disjoint (d.o.elems (Kernels.AttnFwd.below (Kernels.AttnFwd.rows d * d.HEAD_DIM)))
              (d.M.elems (Kernels.AttnFwd.below (Kernels.AttnFwd.rows d))) ∧
            Disjoint (d.M.elems (Kernels.AttnFwd.below (Kernels.AttnFwd.rows d)))
                (d.q.elems (Kernels.AttnFwd.below (Kernels.AttnFwd.rows d * d.HEAD_DIM))) ∧
              Disjoint (d.M.elems (Kernels.AttnFwd.below (Kernels.AttnFwd.rows d)))
                  (d.k.elems (Kernels.AttnFwd.below (Kernels.AttnFwd.rows d * d.HEAD_DIM))) ∧
                Disjoint (d.M.elems (Kernels.AttnFwd.below (Kernels.AttnFwd.rows d)))
                  (d.v.elems (Kernels.AttnFwd.below (Kernels.AttnFwd.rows d * d.HEAD_DIM)))
constructor:
  Kernels.AttnFwd.Inst.ok.mk {d : Kernels.AttnFwd.Inst}
    (head_dim : d.HEAD_DIM = 64 ∨ d.HEAD_DIM = 128 ∨ d.HEAD_DIM = 256) (n_mul : 0 < d.N_CTX ∧ d.N_CTX % 128 = 0)
    (n_le : d.N_CTX ≤ 2 ^ 16) (zh_pos : 0 < d.Z ∧ 0 < d.H) (zh_lt : d.Z * d.H < 2 ^ 16)
    (rows_lt : Kernels.AttnFwd.rows d < 2 ^ 31)
    (scale :
      TVA.FloatV.isFinite d.sm_scale = Bool.true ∧
        1 / 2 ^ 64 ≤ TVA.FloatV.toRat d.sm_scale ∧ TVA.FloatV.toRat d.sm_scale ≤ 2 ^ 64)
    (lens :
      Kernels.AttnFwd.rows d * d.HEAD_DIM ≤ d.q.len ∧
        Kernels.AttnFwd.rows d * d.HEAD_DIM ≤ d.k.len ∧
          Kernels.AttnFwd.rows d * d.HEAD_DIM ≤ d.v.len ∧
            Kernels.AttnFwd.rows d * d.HEAD_DIM ≤ d.o.len ∧ Kernels.AttnFwd.rows d ≤ d.M.len)
    (align : d.q.base % 16 = 0 ∧ d.k.base % 16 = 0 ∧ d.v.base % 16 = 0 ∧ d.o.base % 16 = 0)
    (disj :
      Disjoint (d.o.elems (Kernels.AttnFwd.below (Kernels.AttnFwd.rows d * d.HEAD_DIM)))
          (d.q.elems (Kernels.AttnFwd.below (Kernels.AttnFwd.rows d * d.HEAD_DIM))) ∧
        Disjoint (d.o.elems (Kernels.AttnFwd.below (Kernels.AttnFwd.rows d * d.HEAD_DIM)))
            (d.k.elems (Kernels.AttnFwd.below (Kernels.AttnFwd.rows d * d.HEAD_DIM))) ∧
          Disjoint (d.o.elems (Kernels.AttnFwd.below (Kernels.AttnFwd.rows d * d.HEAD_DIM)))
              (d.v.elems (Kernels.AttnFwd.below (Kernels.AttnFwd.rows d * d.HEAD_DIM))) ∧
            Disjoint (d.o.elems (Kernels.AttnFwd.below (Kernels.AttnFwd.rows d * d.HEAD_DIM)))
                (d.M.elems (Kernels.AttnFwd.below (Kernels.AttnFwd.rows d))) ∧
              Disjoint (d.M.elems (Kernels.AttnFwd.below (Kernels.AttnFwd.rows d)))
                  (d.q.elems (Kernels.AttnFwd.below (Kernels.AttnFwd.rows d * d.HEAD_DIM))) ∧
                Disjoint (d.M.elems (Kernels.AttnFwd.below (Kernels.AttnFwd.rows d)))
                    (d.k.elems (Kernels.AttnFwd.below (Kernels.AttnFwd.rows d * d.HEAD_DIM))) ∧
                  Disjoint (d.M.elems (Kernels.AttnFwd.below (Kernels.AttnFwd.rows d)))
                    (d.v.elems (Kernels.AttnFwd.below (Kernels.AttnFwd.rows d * d.HEAD_DIM)))) :
    d.ok
def Kernels.AttnFwd.Pre : Kernels.AttnFwd.Inst → TVA.Mem → Prop :=
fun d init => d.q.Valid init ∧ d.k.Valid init ∧ d.v.Valid init ∧ d.o.Valid init ∧ d.M.Valid init
def Kernels.AttnFwd.Post : Kernels.AttnFwd.Inst → TVA.Mem → TVA.Mem → Prop :=
fun d init fin =>
  (∀ (bh n e : ℕ),
      bh < d.Z * d.H →
        n < d.N_CTX →
          e < d.HEAD_DIM →
            ∃ c,
              fin.read TVA.DType.f16 (d.o.ptr ↑(Kernels.AttnFwd.idx d bh n e)).addr = Option.some c ∧
                (Kernels.AttnFwd.HeadOk d init bh →
                  TVA.FloatV.isFinite c = Bool.true ∧
                    ∀ X ≤ 2 ^ 10,
                      (∀ j ∈ Kernels.AttnFwd.keys d n,
                          Kernels.AttnFwd.sigma d * Kernels.AttnFwd.scoreAbs d init bh n j ≤ X) →
                        |TVA.FloatV.toReal c - Kernels.AttnFwd.attnRef d init bh n e| ≤
                          ↑(Kernels.AttnFwd.tolO d.HEAD_DIM d.N_CTX X) * Kernels.AttnFwd.attnAbs d init bh n e +
                              ↑(Kernels.AttnFwd.tolS d.HEAD_DIM d.N_CTX X) * ↑(Kernels.AttnFwd.vAbsSum d init bh n e) +
                            ↑(Kernels.AttnFwd.tolF d.HEAD_DIM d.N_CTX X))) ∧
    (∀ (bh n : ℕ),
        bh < d.Z * d.H →
          n < d.N_CTX →
            ∃ c,
              fin.read TVA.DType.f32 (d.M.ptr ↑(bh * d.N_CTX + n)).addr = Option.some c ∧
                (Kernels.AttnFwd.HeadOk d init bh →
                  TVA.FloatV.isFinite c = Bool.true ∧
                    ∀ X ≤ 2 ^ 10,
                      (∀ j ∈ Kernels.AttnFwd.keys d n,
                          Kernels.AttnFwd.sigma d * Kernels.AttnFwd.scoreAbs d init bh n j ≤ X) →
                        |TVA.FloatV.toReal c - Kernels.AttnFwd.lseRef d init bh n| ≤
                          ↑(Kernels.AttnFwd.tolM d.HEAD_DIM d.N_CTX X) +
                            ↑Kernels.AttnFwd.u32 * |Kernels.AttnFwd.lseRef d init bh n|)) ∧
      ∀ z ∉ Kernels.AttnFwd.outBytes d, fin z = init z
structure Kernels.AttnFwd.Assumptions (K : TVA.Claim.Behaviour Kernels.AttnFwd.Inst) (P : TVA.Platform) : Prop
number of parameters: 2
fields:
  Kernels.AttnFwd.Assumptions.faithful : ∀ (d : Kernels.AttnFwd.Inst),
      d.ok → TVA.Rules.Compiler.Faithful P (Kernels.AttnFwd.model d) (Kernels.AttnFwd.launch d) (K d)
  Kernels.AttnFwd.Assumptions.dot : TVA.Rules.Num.DotF16 P
  Kernels.AttnFwd.Assumptions.dot_total : TVA.Rules.Num.DotTotal P
      { a := TVA.DType.f16, b := TVA.DType.f16, acc := TVA.DType.f32 }
  Kernels.AttnFwd.Assumptions.exp2 : TVA.Rules.Num.Exp2F32 P
  Kernels.AttnFwd.Assumptions.exp2_ninf : TVA.Rules.Num.Exp2F32NegInf P
  Kernels.AttnFwd.Assumptions.exp2_total : TVA.Rules.Num.MathTotal P TVA.MathFn.exp2 TVA.Math.Float.Format.binary32
  Kernels.AttnFwd.Assumptions.log2 : TVA.Rules.Num.Log2F32 P
  Kernels.AttnFwd.Assumptions.log2_total : TVA.Rules.Num.MathTotal P TVA.MathFn.log2 TVA.Math.Float.Format.binary32
  Kernels.AttnFwd.Assumptions.div_full : TVA.Rules.Num.DivFull P
  Kernels.AttnFwd.Assumptions.div_total : TVA.Rules.Num.DivTotal P TVA.Math.Float.Format.binary32
constructor:
  Kernels.AttnFwd.Assumptions.mk {K : TVA.Claim.Behaviour Kernels.AttnFwd.Inst} {P : TVA.Platform}
    (faithful :
      ∀ (d : Kernels.AttnFwd.Inst),
        d.ok → TVA.Rules.Compiler.Faithful P (Kernels.AttnFwd.model d) (Kernels.AttnFwd.launch d) (K d))
    (dot : TVA.Rules.Num.DotF16 P)
    (dot_total : TVA.Rules.Num.DotTotal P { a := TVA.DType.f16, b := TVA.DType.f16, acc := TVA.DType.f32 })
    (exp2 : TVA.Rules.Num.Exp2F32 P) (exp2_ninf : TVA.Rules.Num.Exp2F32NegInf P)
    (exp2_total : TVA.Rules.Num.MathTotal P TVA.MathFn.exp2 TVA.Math.Float.Format.binary32)
    (log2 : TVA.Rules.Num.Log2F32 P)
    (log2_total : TVA.Rules.Num.MathTotal P TVA.MathFn.log2 TVA.Math.Float.Format.binary32)
