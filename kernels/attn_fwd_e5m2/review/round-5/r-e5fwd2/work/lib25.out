constructor:
  Kernels.AttnFwdE5m2.Assumptions.mk {K : TVA.Claim.Behaviour Kernels.AttnFwdE5m2.Inst} {P : TVA.Platform}
    (faithful :
      ∀ (d : Kernels.AttnFwdE5m2.Inst),
