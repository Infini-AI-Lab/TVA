def TVA.Rules.Num.DotE5m2Chunk : TVA.Platform → Prop :=
fun P => TVA.Rules.Num.DotF8Chunk P TVA.DType.f8e5 TVA.DType.f8e5
def TVA.Rules.Num.DotF8Chunk : TVA.Platform → TVA.DType → TVA.DType → Prop :=
fun P a b =>
  ∀ (p : TVA.InputPrecision),
    TVA.Rules.Num.DotChunkAcc P { a := a, b := b, acc := TVA.DType.f32, precision := p, maxImpreciseAcc := 2 ^ 30 }
      TVA.Rules.Num.rhoChunk8 TVA.Rules.Num.sigmaChunk8 TVA.Rules.Num.alphaChunk8
def TVA.Rules.Num.liftMag : TVA.DType → ℚ → ℚ :=
fun d q => if q = 0 then 0 else Max.max |q| (TVA.Rules.Num.minNormal8 d)
def TVA.Rules.Num.rhoChunk8 : ℚ :=
2 ^ (-7)
def TVA.Rules.Num.sigmaChunk8 : ℚ :=
2 ^ (-12)
def TVA.Rules.Num.alphaChunk8 : ℚ :=
2 ^ (-126)
