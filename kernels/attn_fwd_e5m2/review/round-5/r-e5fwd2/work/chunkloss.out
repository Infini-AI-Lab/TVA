'Kernels.AttnFwdE5m2.main' depends on axioms: [propext, Classical.choice, Quot.sound]
'Kernels.AttnFwdE5m2.consistent' depends on axioms: [propext, Classical.choice, Quot.sound]
'Kernels.AttnFwdE5m2.satisfiable' depends on axioms: [propext, Classical.choice, Quot.sound]
@Kernels.AttnFwdE5m2.Assumptions.dot : ∀ {K : TVA.Claim.Behaviour Kernels.AttnFwdE5m2.Inst} {P : TVA.Platform},
  Kernels.AttnFwdE5m2.Assumptions K P → TVA.Rules.Num.DotE5m2ChunkLoss P
def TVA.Rules.Num.DotE5m2ChunkLoss : TVA.Platform → Prop :=
fun P => TVA.Rules.Num.DotF8ChunkLoss P TVA.DType.f8e5 TVA.DType.f8e5
def TVA.Rules.Num.DotF8ChunkLoss : TVA.Platform → TVA.DType → TVA.DType → Prop :=
fun P a b =>
  ∀ (p : TVA.InputPrecision),
    TVA.Rules.Num.DotChunkLoss P { a := a, b := b, acc := TVA.DType.f32, precision := p, maxImpreciseAcc := 2 ^ 30 }
      TVA.Rules.Num.rhoChunk8 TVA.Rules.Num.sigmaChunk8 TVA.Rules.Num.alphaChunk8 TVA.Rules.Num.kappaChunk8
      TVA.Rules.Num.rhoLossChunk8
def TVA.Rules.Num.DotChunkLoss : TVA.Platform → TVA.DotCfg → ℚ → ℚ → ℚ → ℚ → ℚ → Prop :=
fun P cfg rho sigma alpha kappa rho' =>
  ∀ ⦃M N K : ℕ⦄ (a : TVA.Tensor [M, K] cfg.a.Val) (b : TVA.Tensor [K, N] cfg.b.Val)
    (acc r : TVA.Tensor [M, N] cfg.acc.Val),
    P.dot cfg a b acc r →
      ∀ (i : Fin M) (n : Fin N) (va vb : Fin K → ℚ) (vc : ℚ),
        (∀ (k : Fin K), cfg.a.val? (a.get2 i k) = Option.some (va k)) →
          (∀ (k : Fin K), cfg.b.val? (b.get2 k n) = Option.some (vb k)) →
            cfg.acc.val? (acc.get2 i n) = Option.some vc →
              |vc| + ∑ k, |va k * vb k| +
                    (TVA.Rules.Num.relDot8 K * (|vc| + ∑ k, |va k * vb k|) + TVA.Rules.Num.absDot8 K) ≤
                  cfg.acc.bound →
                ∃ s vr,
                  cfg.acc.val? (r.get2 i n) = Option.some vr ∧
                    s 0 = vc ∧
                      s (TVA.Rules.Num.chunks8 K) = vr ∧
                        ∀ j < TVA.Rules.Num.chunks8 K,
                          ∀ (Mj : ℚ),
                            |s j| ≤ Mj →
                              (∀ k ∈ TVA.Rules.Num.chunk8 K j,
                                  TVA.Rules.Num.liftMag cfg.a (va k) * TVA.Rules.Num.liftMag cfg.b (vb k) ≤ Mj) →
                                |s (j + 1) - (s j + TVA.Rules.Num.chunkSum8 va vb j)| ≤
                                  Min.min (rho * Mj) (kappa * TVA.Rules.Num.chunkAbs8 va vb j + rho' * Mj) +
                                      sigma * |s j + TVA.Rules.Num.chunkSum8 va vb j| +
                                    alpha
def Kernels.AttnFwdE5m2.scoreErr : Kernels.AttnFwdE5m2.Inst → TVA.Mem → ℕ → ℕ → ℕ → ℚ :=
fun d m bh n j =>
  TVA.Dot8Chunk.errM TVA.Rules.Num.rhoChunk8 TVA.Rules.Num.sigmaChunk8 TVA.Rules.Num.alphaChunk8
    TVA.Rules.Num.kappaChunk8 TVA.Rules.Num.rhoLossChunk8 0
    (TVA.Rules.Num.chunkSum8 (Kernels.AttnFwdE5m2.qrow d m bh n) (Kernels.AttnFwdE5m2.krow d m bh j))
    (TVA.Rules.Num.chunkAbs8 (Kernels.AttnFwdE5m2.qrow d m bh n) (Kernels.AttnFwdE5m2.krow d m bh j))
    (TVA.Dot8Chunk.chunkLift8 TVA.DType.f8e5 TVA.DType.f8e5 (Kernels.AttnFwdE5m2.qrow d m bh n)
      (Kernels.AttnFwdE5m2.krow d m bh j))
    (TVA.Rules.Num.chunks8 d.HEAD_DIM)
def Kernels.AttnFwdE5m2.stepC : ℝ → ℝ → ℝ → ℝ → ℝ × ℝ → ℝ → ℝ → ℝ → ℝ → ℝ → ℝ → ℝ → ℝ → ℝ × ℝ :=
fun W pe dm R st C Lw Bc BV Bl Ba BVa Bv =>
  if
      0 < W ∧
        Kernels.AttnFwdE5m2.errStep pe dm (↑Kernels.AttnFwdE5m2.lS8) (↑Kernels.AttnFwdE5m2.lC8)
                (↑Kernels.AttnFwdE5m2.lP8) st.1 C R st.2 Lw Bc BV Bl /
              W +
            Kernels.AttnFwdE5m2.accStep dm (↑Kernels.AttnFwdE5m2.lC8) (↑Kernels.AttnFwdE5m2.lP8) 0 R st.2 Ba BVa Bv <
          Kernels.AttnFwdE5m2.errStep pe dm (↑Kernels.AttnFwdE5m2.cS8) (↑Kernels.AttnFwdE5m2.cC8)
                (↑Kernels.AttnFwdE5m2.cP8) st.1 C R st.2 Lw Bc Bc Bl /
              W +
            Kernels.AttnFwdE5m2.accStep dm (↑Kernels.AttnFwdE5m2.cC8) (↑Kernels.AttnFwdE5m2.cP8)
              (↑Kernels.AttnFwdE5m2.cC8) R st.2 Ba Ba Bv then
    (Kernels.AttnFwdE5m2.errStep pe dm (↑Kernels.AttnFwdE5m2.lS8) (↑Kernels.AttnFwdE5m2.lC8) (↑Kernels.AttnFwdE5m2.lP8)
        st.1 C R st.2 Lw Bc BV Bl,
      Kernels.AttnFwdE5m2.accStep dm (↑Kernels.AttnFwdE5m2.lC8) (↑Kernels.AttnFwdE5m2.lP8) 0 R st.2 Ba BVa Bv)
  else
    (Kernels.AttnFwdE5m2.errStep pe dm (↑Kernels.AttnFwdE5m2.cS8) (↑Kernels.AttnFwdE5m2.cC8) (↑Kernels.AttnFwdE5m2.cP8)
        st.1 C R st.2 Lw Bc Bc Bl,
      Kernels.AttnFwdE5m2.accStep dm (↑Kernels.AttnFwdE5m2.cC8) (↑Kernels.AttnFwdE5m2.cP8) (↑Kernels.AttnFwdE5m2.cC8) R
        st.2 Ba Ba Bv)
def Kernels.AttnFwdE5m2.stC : Kernels.AttnFwdE5m2.Inst → TVA.Mem → ℕ → ℕ → ℕ → ℚ → ℚ → ℝ → ℕ → ℝ × ℝ :=
fun d m bh n e X Z W x => Nat.brecOn x (Kernels.AttnFwdE5m2.stC._f d m bh n e X Z W)
def Kernels.AttnFwdE5m2.tolOW : Kernels.AttnFwdE5m2.Inst → TVA.Mem → ℕ → ℕ → ℕ → ℚ → ℚ → ℝ → ℝ :=
fun d m bh n e X Z W =>
  9 / 8 *
        ((Kernels.AttnFwdE5m2.errC d m bh n e X Z W (Kernels.AttnFwdE5m2.nblk d n) / Kernels.AttnFwdE5m2.wsum d m bh n /
                  Kernels.AttnFwdE5m2.Fp d.HEAD_DIM d.N_CTX X Z +
                Kernels.AttnFwdE5m2.accA d m bh n e X Z W (Kernels.AttnFwdE5m2.nblk d n)) *
              (1 + 1 / 2 ^ 22) +
            |Kernels.AttnFwdE5m2.attnRef d m bh n e| / 2 ^ 22 +
          1 / 2 ^ 148) +
      |Kernels.AttnFwdE5m2.attnRef d m bh n e| / 8 +
    1 / 2 ^ 17
def Kernels.AttnFwdE5m2.tolO : Kernels.AttnFwdE5m2.Inst → TVA.Mem → ℕ → ℕ → ℕ → ℚ → ℚ → ℝ :=
fun d m bh n e X Z =>
  Min.min
    (Kernels.AttnFwdE5m2.tolOW d m bh n e X Z
      (Kernels.AttnFwdE5m2.wsum d m bh n * Kernels.AttnFwdE5m2.Fp d.HEAD_DIM d.N_CTX X Z))
    (Kernels.AttnFwdE5m2.tolOW d m bh n e X Z 0)
def Kernels.AttnFwdE5m2.errStep : ℝ → ℝ → ℝ → ℝ → ℝ → ℝ → ℝ → ℝ → ℝ → ℝ → ℝ → ℝ → ℝ → ℝ :=
fun pe dm cs cc cp EC C R A Lw Bc Bq Bl =>
  (1 + Kernels.AttnFwdE5m2.gD cs dm) * EC + Kernels.AttnFwdE5m2.gD cs dm * Kernels.AttnFwdE5m2.kap pe * |C| +
          (Kernels.AttnFwdE5m2.gD cs dm + Kernels.AttnFwdE5m2.etaA dm) * (R + A) * Lw +
        Kernels.AttnFwdE5m2.hw pe * Bc +
      cc * Kernels.AttnFwdE5m2.b8 pe * Bq +
    cp * Kernels.AttnFwdE5m2.b8 pe * Bl
def Kernels.AttnFwdE5m2.accStep : ℝ → ℝ → ℝ → ℝ → ℝ → ℝ → ℝ → ℝ → ℝ → ℝ :=
fun dm cc cp cr R A Ba Bq Bv =>
  (1 + 1 / 2 ^ 50) *
      Max.max ((A + 3 * (1 + Kernels.AttnFwdE5m2.etaA dm) * R / 2 ^ 24) / Kernels.AttnFwdE5m2.denX dm)
        (R * Kernels.AttnFwdE5m2.coefD cr / Kernels.AttnFwdE5m2.denS) +
    2 *
      (↑Kernels.AttnFwdE5m2.eps8 * Ba + cc * ↑Kernels.AttnFwdE5m2.eps8 * Bq +
            cp * (↑Kernels.AttnFwdE5m2.eps8 + 1 / 2 ^ 14) * Bv +
          R * (1 + cr) / 2 ^ 11 +
        (1 + R + A) / 2 ^ 50)
def Kernels.AttnFwdE5m2.blkV : Kernels.AttnFwdE5m2.Inst → TVA.Mem → ℕ → ℕ → ℕ → ℕ → ℝ :=
fun d m bh n e t =>
  ∑ j ∈ Kernels.AttnFwdE5m2.keysBlk d n t,
    Kernels.AttnFwdE5m2.weight d m bh n j * |↑(Kernels.AttnFwdE5m2.vEff d m bh j e)|
def Kernels.AttnFwdE5m2.blkAbsV : Kernels.AttnFwdE5m2.Inst → TVA.Mem → ℕ → ℕ → ℕ → ℕ → ℝ :=
fun d m bh n e t => ∑ j ∈ Kernels.AttnFwdE5m2.keysBlk d n t, |↑(Kernels.AttnFwdE5m2.vEff d m bh j e)|
def Kernels.AttnFwdE5m2.lS8 : ℚ :=
(TVA.Rules.Num.rhoLossChunk8 + TVA.Rules.Num.sigmaChunk8) *
  (2 + TVA.Rules.Num.rhoLossChunk8 + TVA.Rules.Num.sigmaChunk8)
def Kernels.AttnFwdE5m2.lC8 : ℚ :=
(1 + TVA.Rules.Num.rhoLossChunk8 + TVA.Rules.Num.sigmaChunk8) *
      (TVA.Rules.Num.kappaChunk8 + TVA.Rules.Num.sigmaChunk8) +
    TVA.Rules.Num.rhoLossChunk8 +
  TVA.Rules.Num.sigmaChunk8
def Kernels.AttnFwdE5m2.lP8 : ℚ :=
TVA.Rules.Num.rhoLossChunk8 * (1 + TVA.Rules.Num.rhoLossChunk8 + TVA.Rules.Num.sigmaChunk8)
def TVA.Dot8Chunk.errM : ℚ → ℚ → ℚ → ℚ → ℚ → ℚ → (ℕ → ℚ) → (ℕ → ℚ) → (ℕ → ℚ) → ℕ → ℚ :=
fun ρ σ α κ ρ' v c a m x => Nat.brecOn x (TVA.Dot8Chunk.errM._f ρ σ α κ ρ' v c a m)
