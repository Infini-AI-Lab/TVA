'Kernels.AttnFwdE5m2.main' depends on axioms: [propext, Classical.choice, Quot.sound]
'Kernels.AttnFwdE5m2.consistent' depends on axioms: [propext, Classical.choice, Quot.sound]
'Kernels.AttnFwdE5m2.satisfiable' depends on axioms: [propext, Classical.choice, Quot.sound]
def TVA.Rules.Num.DotE5m2Chunk : TVA.Platform → Prop :=
fun P => TVA.Rules.Num.DotF8Chunk P TVA.DType.f8e5 TVA.DType.f8e5
def TVA.Rules.Num.DotF8Chunk : TVA.Platform → TVA.DType → TVA.DType → Prop :=
fun P a b =>
  ∀ (p : TVA.InputPrecision),
    TVA.Rules.Num.DotChunkAcc P { a := a, b := b, acc := TVA.DType.f32, precision := p, maxImpreciseAcc := 2 ^ 30 }
      TVA.Rules.Num.rhoChunk8 TVA.Rules.Num.sigmaChunk8 TVA.Rules.Num.alphaChunk8
def TVA.Rules.Num.DotChunkAcc : TVA.Platform → TVA.DotCfg → ℚ → ℚ → ℚ → Prop :=
fun P cfg rho sigma alpha =>
  ∀ ⦃M N K : ℕ⦄ (a : TVA.Tensor [M, K] cfg.a.Val) (b : TVA.Tensor [K, N] cfg.b.Val)
    (acc r : TVA.Tensor [M, N] cfg.acc.Val),
    P.dot cfg a b acc r →
      ∀ (i : Fin M) (n : Fin N) (va vb : Fin K → ℚ) (vc : ℚ),
        (∀ (k : Fin K), cfg.a.val? (a.get2 i k) = Option.some (va k)) →
          (∀ (k : Fin K), cfg.b.val? (b.get2 k n) = Option.some (vb k)) →
            cfg.acc.val? (acc.get2 i n) = Option.some vc →
              |vc| + ∑ k, |va k * vb k| +
                    (TVA.Rules.Num.relDot8 K * (|vc| + ∑ k, |va k * vb k|) + TVA.Rules.Num.absDot8 K) ≤
                  cfg.acc.bound →
                ∃ s vr,
                  cfg.acc.val? (r.get2 i n) = Option.some vr ∧
                    s 0 = vc ∧
                      s (TVA.Rules.Num.chunks8 K) = vr ∧
                        ∀ j < TVA.Rules.Num.chunks8 K,
                          ∀ (Mj : ℚ),
                            |s j| ≤ Mj →
                              (∀ k ∈ TVA.Rules.Num.chunk8 K j,
                                  TVA.Rules.Num.liftMag cfg.a (va k) * TVA.Rules.Num.liftMag cfg.b (vb k) ≤ Mj) →
                                |s (j + 1) - (s j + TVA.Rules.Num.chunkSum8 va vb j)| ≤
                                  rho * Mj + sigma * |s j + TVA.Rules.Num.chunkSum8 va vb j| + alpha
def TVA.Rules.Num.rhoChunk8 : ℚ :=
2 ^ (-7)
def TVA.Rules.Num.sigmaChunk8 : ℚ :=
2 ^ (-12)
def TVA.Rules.Num.alphaChunk8 : ℚ :=
2 ^ (-126)
def TVA.Rules.Num.chunk8 : (K : ℕ) → ℕ → Finset (Fin K) :=
fun K j => {k | ↑k / 32 = j}
def TVA.Rules.Num.chunkSum8 : {K : ℕ} → (Fin K → ℚ) → (Fin K → ℚ) → ℕ → ℚ :=
fun {K} va vb j => ∑ k ∈ TVA.Rules.Num.chunk8 K j, va k * vb k
def TVA.Rules.Num.chunks8 : ℕ → ℕ :=
fun K => (K + 31) / 32
def TVA.Dot8Chunk.chunkLift8 : TVA.DType → TVA.DType → {K : ℕ} → (Fin K → ℚ) → (Fin K → ℚ) → ℕ → ℚ :=
fun da db {K} va vb j =>
  Finset.fold Max.max 0 (fun k => TVA.Rules.Num.liftMag da (va k) * TVA.Rules.Num.liftMag db (vb k))
    (TVA.Rules.Num.chunk8 K j)
def TVA.Dot8Chunk.relLift8 : ℕ → ℚ :=
fun K => (1 + (TVA.Rules.Num.rhoChunk8 + TVA.Rules.Num.sigmaChunk8)) ^ TVA.Rules.Num.chunks8 K - 1
def TVA.Dot8Chunk.psum : ℚ → (ℕ → ℚ) → ℕ → ℚ :=
fun v c j => v + ∑ i ∈ Finset.range j, c i
TVA.Dot8Chunk.errB : ℚ → ℚ → ℚ → ℚ → (ℕ → ℚ) → (ℕ → ℚ) → ℕ → ℚ
