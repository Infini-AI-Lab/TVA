  Kernels.AttnFwdE5m2.Assumptions.exp2_total : TVA.Rules.Num.MathTotal P TVA.MathFn.exp2 TVA.Math.Float.Format.binary32
  Kernels.AttnFwdE5m2.Assumptions.log2 : TVA.Rules.Num.Log2F32 P
  Kernels.AttnFwdE5m2.Assumptions.log2_total : TVA.Rules.Num.MathTotal P TVA.MathFn.log2 TVA.Math.Float.Format.binary32
