'Kernels.AttnFwdE5m2.main' depends on axioms: [propext, Classical.choice, Quot.sound]
'Kernels.AttnFwdE5m2.consistent' depends on axioms: [propext, Classical.choice, Quot.sound]
'Kernels.AttnFwdE5m2.satisfiable' depends on axioms: [propext, Classical.choice, Quot.sound]
def Kernels.AttnFwdE5m2.Post : Kernels.AttnFwdE5m2.Inst → TVA.Mem → TVA.Mem → Prop :=
fun d init fin =>
  (∀ (bh n e : ℕ),
      bh < d.Z * d.H →
        n < d.N_CTX →
          e < d.HEAD_DIM →
            ∃ c,
              fin.read TVA.DType.f8e5 (d.o.ptr ↑(Kernels.AttnFwdE5m2.idx d bh n e)).addr = Option.some c ∧
                (Kernels.AttnFwdE5m2.HeadOk d init bh →
                  TVA.FloatV.isFinite c = Bool.true ∧
                    (∀ X ≤ Kernels.AttnFwdE5m2.Xh d.HEAD_DIM,
                        (∀ j ∈ Kernels.AttnFwdE5m2.keys d n,
                            Kernels.AttnFwdE5m2.sigma d * Kernels.AttnFwdE5m2.scoreAbs d init bh n j ≤ X) →
                          |TVA.FloatV.toReal c - Kernels.AttnFwdE5m2.attnRef d init bh n e| ≤
                            Kernels.AttnFwdE5m2.tolO d init bh n e X) ∧
                      ∀ (K : ℝ),
                        (∀ j ∈ Kernels.AttnFwdE5m2.keys d n,
                            |↑(Kernels.AttnFwdE5m2.vEff d init bh j e) - Kernels.AttnFwdE5m2.attnRef d init bh n e| ≤
                              K) →
                          |TVA.FloatV.toReal c - Kernels.AttnFwdE5m2.attnRef d init bh n e| ≤
                            Kernels.AttnFwdE5m2.tolV d init bh n e K)) ∧
    (∀ (bh n : ℕ),
        bh < d.Z * d.H →
          n < d.N_CTX →
            ∃ c,
              fin.read TVA.DType.f32 (d.M.ptr ↑(bh * d.N_CTX + n)).addr = Option.some c ∧
                (Kernels.AttnFwdE5m2.HeadOk d init bh →
                  TVA.FloatV.isFinite c = Bool.true ∧
                    ∀ X ≤ Kernels.AttnFwdE5m2.Xh d.HEAD_DIM,
                      (∀ j ∈ Kernels.AttnFwdE5m2.keys d n,
                          Kernels.AttnFwdE5m2.sigma d * Kernels.AttnFwdE5m2.scoreAbs d init bh n j ≤ X) →
                        |TVA.FloatV.toReal c - Kernels.AttnFwdE5m2.lseRef d init bh n| ≤
                          Kernels.AttnFwdE5m2.tolM d.HEAD_DIM d.N_CTX X +
                            ↑Kernels.AttnFwdE5m2.u32 * |Kernels.AttnFwdE5m2.lseRef d init bh n|)) ∧
      ∀ z ∉ Kernels.AttnFwdE5m2.outBytes d, fin z = init z
def Kernels.AttnFwdE5m2.tolV : Kernels.AttnFwdE5m2.Inst → TVA.Mem → ℕ → ℕ → ℕ → ℝ → ℝ :=
fun d m bh n e K =>
  9 / 8 *
        ((Kernels.AttnFwdE5m2.magA K |Kernels.AttnFwdE5m2.attnRef d m bh n e| (Kernels.AttnFwdE5m2.nblk d n) +
                2 *
                  Kernels.AttnFwdE5m2.magD K |Kernels.AttnFwdE5m2.attnRef d m bh n e| (Kernels.AttnFwdE5m2.nblk d n)) *
              (1 + 1 / 2 ^ 22) +
            |Kernels.AttnFwdE5m2.attnRef d m bh n e| / 2 ^ 22 +
          1 / 2 ^ 148) +
      |Kernels.AttnFwdE5m2.attnRef d m bh n e| / 8 +
    1 / 2 ^ 17
def Kernels.AttnFwdE5m2.magA : ℝ → ℝ → ℕ → ℝ :=
fun K R x => Nat.brecOn x (Kernels.AttnFwdE5m2.magA._f K R)
def Kernels.AttnFwdE5m2.magD : ℝ → ℝ → ℕ → ℝ :=
fun K R x => Nat.brecOn x (Kernels.AttnFwdE5m2.magD._f K R)
def Kernels.AttnFwdE5m2.magNext : ℝ → ℝ → ℝ → ℝ :=
fun K R A =>
  Max.max
    (((1 + ↑Kernels.AttnFwdE5m2.rho8) * (1 + 1 / 2 ^ 24) * A +
        R * (4 / 2 ^ 24 + ↑Kernels.AttnFwdE5m2.rho8 * (1 + 1 / 2 ^ 24))) /
      (1 - 3 / 2 ^ 24))
    (Kernels.AttnFwdE5m2.magCp K R / (1 - 1 / 2 ^ 17 - 3 * (1 + 1 / 2 ^ 17) / 2 ^ 24))
def Kernels.AttnFwdE5m2.magCp : ℝ → ℝ → ℝ :=
fun K R =>
  9 / 8 * K * (1 + ↑Kernels.AttnFwdE5m2.rho8) +
    R * (9 / 8 * ↑Kernels.AttnFwdE5m2.rho8 + 1 / 8 + 1 / 2 ^ 17 + 3 * (1 + 1 / 2 ^ 17) / 2 ^ 24)
def Kernels.AttnFwdE5m2.rho8 : ℚ :=
TVA.Rules.Num.relDot8 64
@Kernels.AttnFwdE5m2.final_v : ∀ {P : TVA.Platform},
  TVA.Rules.Num.DivFull P →
    TVA.Rules.Num.CvtSatF32E5m2 P →
      ∀ {a l o' : TVA.F32} {o8 : TVA.F8E5} {r A D : ℝ},
        TVA.FloatV.isFinite a = Bool.true →
          TVA.FloatV.isFinite l = Bool.true →
            1 / 2 ≤ TVA.FloatV.toReal l →
              |TVA.FloatV.toReal a| ≤ 2 ^ 58 →
                |r| ≤ 57344 →
                  0 ≤ D →
                    |TVA.FloatV.toReal a - r * TVA.FloatV.toReal l| ≤ A * TVA.FloatV.toReal l + D →
                      P.div TVA.Math.Float.Format.binary32 a l o' →
                        P.cvt TVA.Math.Float.Format.binary32 TVA.Math.Float.Format.e5m2 TVA.Math.Float.RoundMode.rn o'
                            o8 →
                          TVA.FloatV.isFinite o8 = Bool.true ∧
                            |TVA.FloatV.toReal o8 - r| ≤
                              9 / 8 * ((A + 2 * D) * (1 + 1 / 2 ^ 22) + |r| / 2 ^ 22 + 1 / 2 ^ 148) + |r| / 8 +
                                1 / 2 ^ 17
@Kernels.AttnFwdE5m2.mag_tail : ∀ {P : TVA.Platform},
  TVA.Rules.Num.Exp2F32 P →
    TVA.Rules.Num.Exp2F32NegInf P →
      TVA.Rules.Num.CvtSatF32E5m2 P →
        ∀ {R : Kernels.AttnFwdE5m2.RowCtx},
          R.Ok →
            ∀ {t : ℕ},
              t + 1 ≤ 1024 →
                ∀ {fusion : Bool} {D : ℕ} {ve : Fin D → ℕ → ℝ} {m m' dm al l lij l' : TVA.F32} {x p : Fin 64 → TVA.F32}
                  {q : Fin 64 → TVA.F8E5} {vt : Fin 64 → Fin D → TVA.F8E5} {acc a1 acc' : Fin D → TVA.F32},
                  Kernels.AttnFwdE5m2.MInv R (t + 1) m' →
                    Kernels.AttnFwdE5m2.LaneX R t m' x →
                      Kernels.AttnFwdE5m2.AlphaIn t m m' dm →
                        (0 < t ∧ m' = m ∨ ∃ jj, |TVA.FloatV.toReal (x jj)| ≤ 1 / 2 ^ 11) →
                          (∀ (jj : Fin 64), P.math TVA.MathFn.exp2 TVA.Math.Float.Format.binary32 (x jj) (p jj)) →
                            P.math TVA.MathFn.exp2 TVA.Math.Float.Format.binary32 dm al →
                              (∃ tr,
                                  TVA.Tree.Covers 64 tr ∧
                                    TVA.Tree.Eval (TVA.AddRel Bool.false) (Kernels.AttnFwdE5m2.laneSeq p) tr lij) →
                                (∀ (jj : Fin 64),
                                    P.cvt TVA.Math.Float.Format.binary32 TVA.Math.Float.Format.e5m2
                                      TVA.Math.Float.RoundMode.rn (p jj) (q jj)) →
                                  (∀ (e : Fin D), (TVA.FloatV.mul (acc e) al).NaNEq (a1 e)) →
                                    (∀ (jj : Fin 64) (e : Fin D),
                                        TVA.FloatV.isFinite (vt jj e) = Bool.true ∧
                                          TVA.FloatV.toReal (vt jj e) = ve e (64 * t + ↑jj)) →
                                      (∀ (e : Fin D),
                                          |TVA.FloatV.toReal (acc' e) -
                                                (TVA.FloatV.toReal (a1 e) +
                                                  ∑ jj, TVA.FloatV.toReal (q jj) * TVA.FloatV.toReal (vt jj e))| ≤
                                            Kernels.AttnFwdE5m2.rho8r *
                                                (|TVA.FloatV.toReal (a1 e)| +
                                                  ∑ jj, |TVA.FloatV.toReal (q jj) * TVA.FloatV.toReal (vt jj e)|) +
                                              16641 / 2 ^ 139) →
                                        ((TVA.FloatV.mul l al).add lij).NaNEq l' ∨
                                            fusion = Bool.true ∧ (TVA.FloatV.fma l al lij).NaNEq l' →
                                          Kernels.AttnFwdE5m2.RowSt R ve t m l acc →
                                            Kernels.AttnFwdE5m2.lminB (t + 1) ≤ TVA.FloatV.toReal l' ∧
                                              ∀ (e : Fin D) (r K : ℝ),
                                                0 ≤ K →
                                                  (∀ (j : ℕ), R.al j = Bool.true → |ve e j - r| ≤ K) →
                                                    |TVA.FloatV.toReal (acc' e) - r * TVA.FloatV.toReal l'| ≤
                                                      Kernels.AttnFwdE5m2.magA K |r| (t + 1) * TVA.FloatV.toReal l' +
                                                        Kernels.AttnFwdE5m2.magD K |r| (t + 1)
@Kernels.AttnFwdE5m2.lmin_real : ∀ {l l' α lij : ℝ} {p : Fin 64 → ℝ} {t : ℕ},
  t ≤ 1024 →
    0 ≤ l →
      l ≤ 2 ^ 44 →
        -(1 / 2 ^ 126) ≤ α →
          (∀ (jj : Fin 64), -(1 / 2 ^ 125) ≤ p jj) →
            (∀ (jj : Fin 64), |p jj| ≤ 2) →
              |lij - ∑ jj, p jj| ≤ Kernels.AttnFwdE5m2.gamr * ∑ jj, |p jj| + 63 / 2 ^ 150 * (1 + 1 / 2 ^ 24) ^ 63 →
                |l' - (l * α + lij)| ≤ 3 * (|l * α| + |lij|) / 2 ^ 24 + 4 / 2 ^ 150 →
                  (Kernels.AttnFwdE5m2.lminB t ≤ l ∧ 1 - 1 / 2 ^ 12 ≤ α ∨ ∃ jj, 1 - 1 / 2 ^ 10 ≤ p jj) →
                    Kernels.AttnFwdE5m2.lminB (t + 1) ≤ l'
