def Kernels.AttnFwdE5m2.magCp : ℝ → ℝ → ℝ :=
fun K R =>
  9 / 8 * K * (1 + ↑Kernels.AttnFwdE5m2.rho8) +
    R * (9 / 8 * ↑Kernels.AttnFwdE5m2.rho8 + 1 / 8 + 1 / 2 ^ 17 + 3 * (1 + 1 / 2 ^ 17) / 2 ^ 24)
def Kernels.AttnFwdE5m2.magNext : ℝ → ℝ → ℝ → ℝ :=
fun K R A =>
  Max.max
    (((1 + ↑Kernels.AttnFwdE5m2.rho8) * (1 + 1 / 2 ^ 24) * A +
        R * (4 / 2 ^ 24 + ↑Kernels.AttnFwdE5m2.rho8 * (1 + 1 / 2 ^ 24))) /
      (1 - 3 / 2 ^ 24))
    (Kernels.AttnFwdE5m2.magCp K R / (1 - 1 / 2 ^ 17 - 3 * (1 + 1 / 2 ^ 17) / 2 ^ 24))
def Kernels.AttnFwdE5m2.magA : ℝ → ℝ → ℕ → ℝ :=
fun K R x => Nat.brecOn x (Kernels.AttnFwdE5m2.magA._f K R)
def Kernels.AttnFwdE5m2.magD : ℝ → ℝ → ℕ → ℝ :=
fun K R x => Nat.brecOn x (Kernels.AttnFwdE5m2.magD._f K R)
def Kernels.AttnFwdE5m2.tolV : Kernels.AttnFwdE5m2.Inst → TVA.Mem → ℕ → ℕ → ℕ → ℝ → ℝ :=
fun d m bh n e K =>
  9 / 8 *
        ((Kernels.AttnFwdE5m2.magA K |Kernels.AttnFwdE5m2.attnRef d m bh n e| (Kernels.AttnFwdE5m2.nblk d n) +
                2 *
                  Kernels.AttnFwdE5m2.magD K |Kernels.AttnFwdE5m2.attnRef d m bh n e| (Kernels.AttnFwdE5m2.nblk d n)) *
              (1 + 1 / 2 ^ 22) +
            |Kernels.AttnFwdE5m2.attnRef d m bh n e| / 2 ^ 22 +
          1 / 2 ^ 148) +
      |Kernels.AttnFwdE5m2.attnRef d m bh n e| / 8 +
    1 / 2 ^ 17
def Kernels.AttnFwdE5m2.rho8 : ℚ :=
TVA.Rules.Num.relDot8 64
def Kernels.AttnFwdE5m2.Post : Kernels.AttnFwdE5m2.Inst → TVA.Mem → TVA.Mem → Prop :=
fun d init fin =>
  (∀ (bh n e : ℕ),
      bh < d.Z * d.H →
        n < d.N_CTX →
          e < d.HEAD_DIM →
            ∃ c,
              fin.read TVA.DType.f8e5 (d.o.ptr ↑(Kernels.AttnFwdE5m2.idx d bh n e)).addr = Option.some c ∧
                (Kernels.AttnFwdE5m2.HeadOk d init bh →
                  TVA.FloatV.isFinite c = Bool.true ∧
                    (∀ X ≤ Kernels.AttnFwdE5m2.Xh d.HEAD_DIM,
                        (∀ j ∈ Kernels.AttnFwdE5m2.keys d n,
                            Kernels.AttnFwdE5m2.sigma d * Kernels.AttnFwdE5m2.scoreAbs d init bh n j ≤ X) →
                          |TVA.FloatV.toReal c - Kernels.AttnFwdE5m2.attnRef d init bh n e| ≤
                            Kernels.AttnFwdE5m2.tolO d init bh n e X) ∧
                      ∀ (K : ℝ),
                        (∀ j ∈ Kernels.AttnFwdE5m2.keys d n,
                            |↑(Kernels.AttnFwdE5m2.vEff d init bh j e) - Kernels.AttnFwdE5m2.attnRef d init bh n e| ≤
                              K) →
                          |TVA.FloatV.toReal c - Kernels.AttnFwdE5m2.attnRef d init bh n e| ≤
                            Kernels.AttnFwdE5m2.tolV d init bh n e K)) ∧
    (∀ (bh n : ℕ),
        bh < d.Z * d.H →
          n < d.N_CTX →
            ∃ c,
              fin.read TVA.DType.f32 (d.M.ptr ↑(bh * d.N_CTX + n)).addr = Option.some c ∧
                (Kernels.AttnFwdE5m2.HeadOk d init bh →
                  TVA.FloatV.isFinite c = Bool.true ∧
                    ∀ X ≤ Kernels.AttnFwdE5m2.Xh d.HEAD_DIM,
                      (∀ j ∈ Kernels.AttnFwdE5m2.keys d n,
                          Kernels.AttnFwdE5m2.sigma d * Kernels.AttnFwdE5m2.scoreAbs d init bh n j ≤ X) →
                        |TVA.FloatV.toReal c - Kernels.AttnFwdE5m2.lseRef d init bh n| ≤
                          Kernels.AttnFwdE5m2.tolM d.HEAD_DIM d.N_CTX X +
                            ↑Kernels.AttnFwdE5m2.u32 * |Kernels.AttnFwdE5m2.lseRef d init bh n|)) ∧
      ∀ z ∉ Kernels.AttnFwdE5m2.outBytes d, fin z = init z
