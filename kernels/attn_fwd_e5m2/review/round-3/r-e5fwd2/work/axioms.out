'Kernels.AttnFwdE5m2.main' depends on axioms: [propext, Classical.choice, Quot.sound]
'Kernels.AttnFwdE5m2.consistent' depends on axioms: [propext, Classical.choice, Quot.sound]
'Kernels.AttnFwdE5m2.satisfiable' depends on axioms: [propext, Classical.choice, Quot.sound]
structure Kernels.AttnFwdE5m2.Assumptions (K : TVA.Claim.Behaviour Kernels.AttnFwdE5m2.Inst) (P : TVA.Platform) : Prop
number of parameters: 2
fields:
  Kernels.AttnFwdE5m2.Assumptions.faithful : ∀ (d : Kernels.AttnFwdE5m2.Inst),
      d.ok → TVA.Rules.Compiler.Faithful P (Kernels.AttnFwdE5m2.model d) (Kernels.AttnFwdE5m2.launch d) (K d)
