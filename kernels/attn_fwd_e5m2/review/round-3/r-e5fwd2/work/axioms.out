    (dot_total :
      TVA.Rules.Num.DotTotal P
        { a := TVA.DType.f8e5, b := TVA.DType.f8e5, acc := TVA.DType.f32, maxImpreciseAcc := 2 ^ 30 })
    (cvt : TVA.Rules.Num.CvtSatF32E5m2 P)
    (cvt_total : TVA.Rules.Num.CvtTotal P TVA.Math.Float.Format.binary32 TVA.Math.Float.Format.e5m2)
    (exp2 : TVA.Rules.Num.Exp2F32 P) (exp2_ninf : TVA.Rules.Num.Exp2F32NegInf P)
    (exp2_total : TVA.Rules.Num.MathTotal P TVA.MathFn.exp2 TVA.Math.Float.Format.binary32)
    (log2 : TVA.Rules.Num.Log2F32 P)
    (log2_total : TVA.Rules.Num.MathTotal P TVA.MathFn.log2 TVA.Math.Float.Format.binary32)
    (div_full : TVA.Rules.Num.DivFull P) (div_total : TVA.Rules.Num.DivTotal P TVA.Math.Float.Format.binary32) :
    Kernels.AttnFwdE5m2.Assumptions K P
def Kernels.AttnFwdE5m2.HeadOk : Kernels.AttnFwdE5m2.Inst → TVA.Mem → ℕ → Prop :=
fun d m bh =>
  (∀ (n e : ℕ),
      n < d.N_CTX →
        e < d.HEAD_DIM →
          Kernels.AttnFwdE5m2.fin8 m d.q (Kernels.AttnFwdE5m2.idx d bh n e) ∧
            Kernels.AttnFwdE5m2.fin8 m d.k (Kernels.AttnFwdE5m2.idx d bh n e)) ∧
    (∀ (n e : ℕ),
        n < d.N_CTX →
          e < d.HEAD_DIM →
            Kernels.AttnFwdE5m2.vIn d bh → Kernels.AttnFwdE5m2.fin8 m d.v (Kernels.AttnFwdE5m2.vIdx d bh n e)) ∧
      ∀ (n j : ℕ),
        n < d.N_CTX →
          j < d.N_CTX →
            Kernels.AttnFwdE5m2.sigma d * Kernels.AttnFwdE5m2.scoreLift d m bh n j ≤ Kernels.AttnFwdE5m2.Xh d.HEAD_DIM
def Kernels.AttnFwdE5m2.scoreLift : Kernels.AttnFwdE5m2.Inst → TVA.Mem → ℕ → ℕ → ℕ → ℚ :=
fun d m bh n j =>
  ∑ e,
    TVA.Rules.Num.liftMag TVA.DType.f8e5 (Kernels.AttnFwdE5m2.qrow d m bh n e) *
      TVA.Rules.Num.liftMag TVA.DType.f8e5 (Kernels.AttnFwdE5m2.krow d m bh j e)
def Kernels.AttnFwdE5m2.scoreErr : Kernels.AttnFwdE5m2.Inst → TVA.Mem → ℕ → ℕ → ℕ → ℚ :=
fun d m bh n j =>
  TVA.Dot8Chunk.errB TVA.Rules.Num.rhoChunk8 TVA.Rules.Num.sigmaChunk8 TVA.Rules.Num.alphaChunk8 0
    (TVA.Rules.Num.chunkSum8 (Kernels.AttnFwdE5m2.qrow d m bh n) (Kernels.AttnFwdE5m2.krow d m bh j))
    (TVA.Dot8Chunk.chunkLift8 TVA.DType.f8e5 TVA.DType.f8e5 (Kernels.AttnFwdE5m2.qrow d m bh n)
      (Kernels.AttnFwdE5m2.krow d m bh j))
    (TVA.Rules.Num.chunks8 d.HEAD_DIM)
def Kernels.AttnFwdE5m2.scoreE : ℕ → ℚ → ℚ → ℚ :=
fun D X Z => Min.min (3 / 2 * Z) (TVA.Dot8Chunk.relLift8 D * Kernels.AttnFwdE5m2.ybound X + 1 / 2 ^ 55)
def Kernels.AttnFwdE5m2.tolO : Kernels.AttnFwdE5m2.Inst → TVA.Mem → ℕ → ℕ → ℕ → ℚ → ℚ → ℝ :=
fun d m bh n e X Z =>
  9 / 8 *
        ((Kernels.AttnFwdE5m2.errC d m bh n e X Z (Kernels.AttnFwdE5m2.nblk d n) / Kernels.AttnFwdE5m2.wsum d m bh n /
                  Kernels.AttnFwdE5m2.Fp d.HEAD_DIM d.N_CTX X Z +
                Kernels.AttnFwdE5m2.accA d m bh n e X Z (Kernels.AttnFwdE5m2.nblk d n)) *
              (1 + 1 / 2 ^ 22) +
            |Kernels.AttnFwdE5m2.attnRef d m bh n e| / 2 ^ 22 +
          1 / 2 ^ 148) +
      |Kernels.AttnFwdE5m2.attnRef d m bh n e| / 8 +
    1 / 2 ^ 17
def Kernels.AttnFwdE5m2.accNext : ℝ → ℝ → ℝ → ℝ → ℝ → ℝ :=
fun dm R A Ba Bv =>
  (1 + 1 / 2 ^ 50) *
      Max.max ((A + 3 * (1 + Kernels.AttnFwdE5m2.etaA dm) * R / 2 ^ 24) / Kernels.AttnFwdE5m2.denX dm)
        (R * Kernels.AttnFwdE5m2.coefS / Kernels.AttnFwdE5m2.denS) +
    2 *
      ((1 + ↑Kernels.AttnFwdE5m2.cC8) * ↑Kernels.AttnFwdE5m2.eps8 * Ba +
            ↑Kernels.AttnFwdE5m2.cP8 * (↑Kernels.AttnFwdE5m2.eps8 + 1 / 2 ^ 14) * Bv +
          R * (1 + ↑Kernels.AttnFwdE5m2.cC8) / 2 ^ 11 +
        (1 + R + A) / 2 ^ 50)
def Kernels.AttnFwdE5m2.errNext : ℝ → ℝ → ℝ → ℝ → ℝ → ℝ → ℝ → ℝ → ℝ → ℝ :=
fun pe dm EC C R A Lw Bc Bl =>
  (1 + Kernels.AttnFwdE5m2.gA dm) * EC + Kernels.AttnFwdE5m2.gA dm * Kernels.AttnFwdE5m2.kap pe * |C| +
        (Kernels.AttnFwdE5m2.gA dm + Kernels.AttnFwdE5m2.etaA dm) * (R + A) * Lw +
      (Kernels.AttnFwdE5m2.hw pe + ↑Kernels.AttnFwdE5m2.cC8 * Kernels.AttnFwdE5m2.b8 pe) * Bc +
    ↑Kernels.AttnFwdE5m2.cP8 * Kernels.AttnFwdE5m2.b8 pe * Bl
def Kernels.AttnFwdE5m2.blkLW : Kernels.AttnFwdE5m2.Inst → TVA.Mem → ℕ → ℕ → ℕ → ℕ → ℝ :=
fun d m bh n e t =>
  ∑ c ∈ Finset.range 2,
    Finset.fold Max.max 0
      (fun k =>
        if 64 * t + ↑k ∈ Kernels.AttnFwdE5m2.keys d n then
          Kernels.AttnFwdE5m2.weight d m bh n (64 * t + ↑k) *
            ↑(TVA.Rules.Num.liftMag TVA.DType.f8e5 (Kernels.AttnFwdE5m2.vEff d m bh (64 * t + ↑k) e))
        else 0)
      (TVA.Rules.Num.chunk8 64 c)
def Kernels.AttnFwdE5m2.iotaV : ℝ → ℝ → ℝ :=
fun K R => Min.min 1 (2 ^ 16 * (K + R))
def Kernels.AttnFwdE5m2.magCp : ℝ → ℝ → ℝ :=
fun K R =>
  9 / 8 * K * (1 + ↑Kernels.AttnFwdE5m2.cS8) +
      R * (9 / 8 * ↑Kernels.AttnFwdE5m2.cS8 + 1 / 8 + 1 / 2 ^ 17 + 3 * (1 + 1 / 2 ^ 17) / 2 ^ 24) +
    9 / 8 * ↑Kernels.AttnFwdE5m2.cP8 * Kernels.AttnFwdE5m2.iotaV K R / 2 ^ 14
def Kernels.AttnFwdE5m2.magD : ℝ → ℝ → ℕ → ℝ :=
fun K R x => Nat.brecOn x (Kernels.AttnFwdE5m2.magD._f K R)
def TVA.Rules.Num.DotE5m2Chunk : TVA.Platform → Prop :=
fun P => TVA.Rules.Num.DotF8Chunk P TVA.DType.f8e5 TVA.DType.f8e5
def TVA.Rules.Num.DotF8Chunk : TVA.Platform → TVA.DType → TVA.DType → Prop :=
fun P a b =>
  ∀ (p : TVA.InputPrecision),
    TVA.Rules.Num.DotChunkAcc P { a := a, b := b, acc := TVA.DType.f32, precision := p, maxImpreciseAcc := 2 ^ 30 }
      TVA.Rules.Num.rhoChunk8 TVA.Rules.Num.sigmaChunk8 TVA.Rules.Num.alphaChunk8
def TVA.Dot8Chunk.errB : ℚ → ℚ → ℚ → ℚ → (ℕ → ℚ) → (ℕ → ℚ) → ℕ → ℚ :=
fun ρ σ α v c m x => Nat.brecOn x (TVA.Dot8Chunk.errB._f ρ σ α v c m)
def TVA.Dot8Chunk.relLift8 : ℕ → ℚ :=
fun K => (1 + (TVA.Rules.Num.rhoChunk8 + TVA.Rules.Num.sigmaChunk8)) ^ TVA.Rules.Num.chunks8 K - 1
@Kernels.AttnFwdE5m2.cstep_real : ∀ {pe dm : ℝ},
  1 ≤ pe →
    0 ≤ dm →
      dm ≤ 1 / 2 ^ 13 →
        ∀ {a a1 a' l l' α lij r lam C0 Cb EC0 A Q P S QA QL Bc Bl Ba Bv Lu Lab tau : ℝ},
          0 ≤ lam →
            0 ≤ l →
              l ≤ 2 ^ 44 →
                |α - lam| ≤ Kernels.AttnFwdE5m2.etaA dm * lam + 1 / 2 ^ 126 →
                  0 ≤ tau →
                    tau ≤ 1 / 2 ^ 66 →
                      |a1 - lam * a| ≤ ((1 + dm) * ((1 + 1 / 2 ^ 22) * (1 + 1 / 2 ^ 24)) - 1) * (lam * |a|) + tau →
                        0 ≤ A →
                          0 ≤ EC0 →
                            |lam * a - r * (lam * l) - Kernels.AttnFwdE5m2.kap pe * C0| ≤ EC0 + A * (lam * l) →
                              0 ≤ Lu →
                                0 ≤ Lab →
                                  Lab ≤ 1 / 2 ^ 56 →
                                    lam * l ≤ Lu + Lab →
                                      |a' - (a1 + Q)| ≤
                                          ↑Kernels.AttnFwdE5m2.cS8 * |a1| + ↑Kernels.AttnFwdE5m2.cC8 * QA +
                                              ↑Kernels.AttnFwdE5m2.cP8 * QL +
                                            ↑Kernels.AttnFwdE5m2.cA8 →
                                        0 ≤ Bc →
                                          0 ≤ Bl →
                                            0 ≤ Ba →
                                              0 ≤ Bv →
                                                QA ≤
                                                    Kernels.AttnFwdE5m2.b8 pe * Bc + ↑Kernels.AttnFwdE5m2.eps8 * Ba +
                                                      |r| * (9 / 8 * S + 1 / 2 ^ 11) →
                                                  QL ≤
                                                      Kernels.AttnFwdE5m2.b8 pe * Bl +
                                                        (↑Kernels.AttnFwdE5m2.eps8 + 1 / 2 ^ 14) * Bv →
                                                    |Q - r * P - Kernels.AttnFwdE5m2.kap pe * Cb| ≤
                                                        Kernels.AttnFwdE5m2.hw pe * Bc +
                                                              ↑Kernels.AttnFwdE5m2.eps8 * Ba +
                                                            |r| * S / 8 +
                                                          |r| / 2 ^ 11 →
                                                      0 ≤ S →
                                                        S - 1 / 2 ^ 118 ≤ P →
                                                          |P| ≤ S →
                                                            |lij - P| ≤ Kernels.AttnFwdE5m2.gamr * S + 1 / 2 ^ 142 →
                                                              |l' - (l * α + lij)| ≤
                                                                  3 * (|l * α| + |lij|) / 2 ^ 24 + 4 / 2 ^ 150 →
                                                                1 / 2 ≤ l' →
                                                                  |a' - r * l' -
                                                                        Kernels.AttnFwdE5m2.kap pe * (C0 + Cb)| ≤
                                                                    Kernels.AttnFwdE5m2.errNext pe dm EC0 C0 |r| A Lu Bc
                                                                        Bl +
                                                                      Kernels.AttnFwdE5m2.accNext dm |r| A Ba Bv * l'
