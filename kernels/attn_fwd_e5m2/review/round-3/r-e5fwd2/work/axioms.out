  Kernels.AttnFwdE5m2.Assumptions.div_full : TVA.Rules.Num.DivFull P
  Kernels.AttnFwdE5m2.Assumptions.div_total : TVA.Rules.Num.DivTotal P TVA.Math.Float.Format.binary32
constructor:
  Kernels.AttnFwdE5m2.Assumptions.mk {K : TVA.Claim.Behaviour Kernels.AttnFwdE5m2.Inst} {P : TVA.Platform}
    (faithful :
      ∀ (d : Kernels.AttnFwdE5m2.Inst),
        d.ok → TVA.Rules.Compiler.Faithful P (Kernels.AttnFwdE5m2.model d) (Kernels.AttnFwdE5m2.launch d) (K d))
