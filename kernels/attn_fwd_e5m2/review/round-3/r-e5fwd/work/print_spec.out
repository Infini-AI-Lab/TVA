def TVA.Dot8Chunk.relLift8 : ℕ → ℚ :=
fun K => (1 + (TVA.Rules.Num.rhoChunk8 + TVA.Rules.Num.sigmaChunk8)) ^ TVA.Rules.Num.chunks8 K - 1
def TVA.Dot8Chunk.chunkLift8 : TVA.DType → TVA.DType → {K : ℕ} → (Fin K → ℚ) → (Fin K → ℚ) → ℕ → ℚ :=
fun da db {K} va vb j =>
  Finset.fold Max.max 0 (fun k => TVA.Rules.Num.liftMag da (va k) * TVA.Rules.Num.liftMag db (vb k))
    (TVA.Rules.Num.chunk8 K j)
