      (TVA.IntV Bool.true (@OfNat.ofNat Nat (nat_lit 32) (instOfNatNat (nat_lit 32))))
fun a b c =>
  @HAdd.hAdd TVA.I32 TVA.I32 TVA.I32
    (@instHAdd TVA.I32 (@TVA.IntV.instAdd Bool.true (@OfNat.ofNat Nat (nat_lit 32) (instOfNatNat (nat_lit 32)))))
    (@HMul.hMul TVA.I32 TVA.I32 TVA.I32
      (@instHMul TVA.I32 (@TVA.IntV.instMul Bool.true (@OfNat.ofNat Nat (nat_lit 32) (instOfNatNat (nat_lit 32)))))
      (@HMul.hMul TVA.I32 TVA.I32 TVA.I32
        (@instHMul TVA.I32 (@TVA.IntV.instMul Bool.true (@OfNat.ofNat Nat (nat_lit 32) (instOfNatNat (nat_lit 32))))) a
        b)
      c)
    a : TVA.I32 → TVA.I32 → TVA.I32 → TVA.I32
def TVA.IntV.le : {s : Bool} → {w : ℕ} → TVA.IntV s w → TVA.IntV s w → Bool :=
fun {s} {w} a b => if s = Bool.true then a.bits.sle b.bits else a.bits.ule b.bits
def TVA.TensorDesc.elemAt : {d : TVA.DType} → TVA.TensorDesc d → (ℕ → ℤ) → ℤ :=
fun {d} D c => (List.map (fun k => c k * ↑(D.strides.getD k 0)) (List.range D.rank)).sum
def TVA.Ptr.offset : {d : TVA.DType} → TVA.Ptr d → ℤ → TVA.Ptr d :=
fun {d} p i => { addr := p.addr + i * ↑d.bytes }
def TVA.tl.addrs : {s : TVA.Shape} →
  {d : TVA.DType} → TVA.Tensor s (TVA.Ptr d) → Option (TVA.Tensor s Bool) → TVA.Idx s → Option ℤ :=
fun {s} {d} ptrs mask i =>
  match mask with
  | Option.none => Option.some (ptrs.get i).addr
  | Option.some m => if m.get i = Bool.true then Option.some (ptrs.get i).addr else Option.none
def TVA.Buf.ptr : {d : TVA.DType} → TVA.Buf d → ℤ → TVA.Ptr d :=
fun {d} b i => { addr := b.base + i * ↑d.bytes }
def TVA.tl.RangeOk : {sg : Bool} → {w : ℕ} → TVA.IntV sg w → TVA.IntV sg w → TVA.IntV sg w → Prop :=
fun {sg} {w} lo hi step =>
  0 < step.toInt ∧
    hi.toInt + step.toInt - 1 ≤ (TVA.Math.Float.Format.intRange Bool.true w).2 ∧
      lo.toInt ≤ (TVA.Math.Float.Format.intRange Bool.true w).2 ∧
        step.toInt ≤ (TVA.Math.Float.Format.intRange Bool.true w).2
def TVA.tl.tripCount : ℤ → ℤ → ℤ → ℕ :=
fun lo hi step => ((hi - lo + step - 1) / step).toNat
def TVA.tl.forN : {σ : Type} → ℕ → (ℕ → σ → TVA.Prog σ) → σ → TVA.Prog σ :=
fun {σ} x x_1 x_2 => Nat.brecOn (motive := fun x => (ℕ → σ → TVA.Prog σ) → σ → TVA.Prog σ) x TVA.tl.forN._f x_1 x_2
def TVA.tl.exp2 : {s : TVA.Shape} →
  {f : TVA.Math.Float.Format} → TVA.Tensor s (TVA.FloatV f) → TVA.Prog (TVA.Tensor s (TVA.FloatV f)) :=
fun {s} {f} => TVA.tl.math TVA.MathFn.exp2
def TVA.tl.log2 : {s : TVA.Shape} →
  {f : TVA.Math.Float.Format} → TVA.Tensor s (TVA.FloatV f) → TVA.Prog (TVA.Tensor s (TVA.FloatV f)) :=
fun {s} {f} => TVA.tl.math TVA.MathFn.log2
def TVA.tl.div : {s : TVA.Shape} →
  {f : TVA.Math.Float.Format} →
    TVA.Tensor s (TVA.FloatV f) → TVA.Tensor s (TVA.FloatV f) → TVA.Prog (TVA.Tensor s (TVA.FloatV f)) :=
fun {s} {f} x y =>
  TVA.Prog.env fun e => TVA.Prog.pick (fun r => ∀ (i : TVA.Idx s), e.P.div f (x.get i) (y.get i) (r.get i)) TVA.Prog.ret
def TVA.tl.sub : {s : TVA.Shape} →
  {f : TVA.Math.Float.Format} →
    TVA.Tensor s (TVA.FloatV f) → TVA.Tensor s (TVA.FloatV f) → TVA.Prog (TVA.Tensor s (TVA.FloatV f)) :=
fun {s} {f} x y => TVA.tl.upToNaN (TVA.Tensor.map2 TVA.FloatV.sub x y)
def TVA.tl.add : {s : TVA.Shape} →
  {f : TVA.Math.Float.Format} →
    TVA.Tensor s (TVA.FloatV f) → TVA.Tensor s (TVA.FloatV f) → TVA.Prog (TVA.Tensor s (TVA.FloatV f)) :=
fun {s} {f} x y => TVA.tl.upToNaN (TVA.Tensor.map2 TVA.FloatV.add x y)
def TVA.tl.mul : {s : TVA.Shape} →
  {f : TVA.Math.Float.Format} →
    TVA.Tensor s (TVA.FloatV f) → TVA.Tensor s (TVA.FloatV f) → TVA.Prog (TVA.Tensor s (TVA.FloatV f)) :=
fun {s} {f} x y => TVA.tl.upToNaN (TVA.Tensor.map2 TVA.FloatV.mul x y)
def TVA.tl.maximum : {s : TVA.Shape} →
  {f : TVA.Math.Float.Format} →
    TVA.Tensor s (TVA.FloatV f) → TVA.Tensor s (TVA.FloatV f) → TVA.Prog (TVA.Tensor s (TVA.FloatV f)) :=
fun {s} {f} x y =>
  TVA.Prog.pick (fun r => ∀ (i : TVA.Idx s), TVA.FloatV.MaxRel Bool.true (x.get i) (y.get i) (r.get i)) TVA.Prog.ret
def TVA.tl.addc : {s : TVA.Shape} →
  {f : TVA.Math.Float.Format} →
    TVA.Tensor s (TVA.FloatV f) → TVA.Tensor s (TVA.FloatV f) → TVA.Prog (TVA.Tensor s (TVA.FloatV f)) :=
fun {s} {f} x y =>
  TVA.Prog.env fun e =>
    TVA.Prog.pick (fun r => ∀ (i : TVA.Idx s), TVA.AddRel e.fusion (x.get i) (y.get i) (r.get i)) TVA.Prog.ret
def TVA.FloatV.litF32 : TVA.F64 → TVA.F32 :=
fun c => if TVA.FloatV.isZero c = Bool.true then TVA.FloatV.ofPat 0 else TVA.FloatV.hostF32 c
def TVA.Tensor.scalar : {α : Type} → α → TVA.Tensor [] α :=
fun {α} a => { get := fun x => a }
def TVA.Tensor.item : {α : Type} → TVA.Tensor [] α → α :=
fun {α} x => x.get ()
def TVA.tl.zeros : (s : TVA.Shape) → (d : TVA.DType) → TVA.Tensor s d.Val :=
fun s d => TVA.Tensor.full (d.ofBits 0)
def TVA.tl.arange : (start stop : ℕ) → TVA.Tensor [stop - start] TVA.I32 :=
fun start stop => TVA.Tensor.arange (↑start) (stop - start)
def TVA.Tensor.trans : {α : Type} → {m n : ℕ} → TVA.Tensor [m, n] α → TVA.Tensor [n, m] α :=
fun {α} {m n} x => TVA.Tensor.of2 fun j i => x.get2 i j
structure TVA.DotCfg : Type
number of parameters: 0
fields:
  TVA.DotCfg.a : TVA.DType
  TVA.DotCfg.b : TVA.DType
  TVA.DotCfg.acc : TVA.DType
  TVA.DotCfg.precision : TVA.InputPrecision :=
    TVA.InputPrecision.tf32
  TVA.DotCfg.maxImpreciseAcc : ℕ :=
    0
constructor:
  TVA.DotCfg.mk (a b acc : TVA.DType) (precision : TVA.InputPrecision) (maxImpreciseAcc : ℕ) : TVA.DotCfg
def TVA.Padding.Holds : {d : TVA.DType} → TVA.Padding → d.Val → Prop :=
fun {d} x x_1 =>
  match x, x_1 with
  | TVA.Padding.undef, x => True
  | TVA.Padding.zero, x => x = d.ofBits 0
  | TVA.Padding.nan, x => d.IsNaN x
def TVA.tl.sum1With : {f : TVA.Math.Float.Format} →
  Bool → {m n : ℕ} → TVA.Tensor [m, n] (TVA.FloatV f) → TVA.Prog (TVA.Tensor [m] (TVA.FloatV f)) :=
fun {f} fusion {m n} x =>
  TVA.Prog.pick
    (fun r =>
      ∀ (i : Fin m),
        ∃ t,
          TVA.Tree.Covers n t ∧
            TVA.Tree.Eval (TVA.AddRel fusion) (fun j => if h : j < n then x.get2 i ⟨j, h⟩ else Inhabited.default) t
              (r.get1 i))
    TVA.Prog.ret
structure TVA.Ctx : Type
number of parameters: 0
fields:
  TVA.Ctx.pid : Fin 3 → ℕ
  TVA.Ctx.grid : Fin 3 → ℕ
constructor:
  TVA.Ctx.mk (pid grid : Fin 3 → ℕ) : TVA.Ctx
