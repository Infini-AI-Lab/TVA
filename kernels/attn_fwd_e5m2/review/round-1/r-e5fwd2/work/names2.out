        TVA.Tensor (@List.cons Nat (@OfNat.ofNat Nat (nat_lit 128) (instOfNatNat (nat_lit 128))) (@List.nil Nat))
          (TVA.Ptr TVA.DType.f32)
fun s o =>
  @HAdd.hAdd TVA.I32
    (TVA.Tensor
      (@List.cons Nat (@OfNat.ofNat Nat (nat_lit 128) (instOfNatNat (nat_lit 128)))
        (@List.cons Nat (@OfNat.ofNat Nat (nat_lit 64) (instOfNatNat (nat_lit 64))) (@List.nil Nat)))
