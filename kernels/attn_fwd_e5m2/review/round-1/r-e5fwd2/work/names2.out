      (@List.cons Nat (@OfNat.ofNat Nat (nat_lit 128) (instOfNatNat (nat_lit 128))) (@List.nil Nat)) TVA.DType.f32
      Bool.true (@OfNat.ofNat Nat (nat_lit 32) (instOfNatNat (nat_lit 32))))
    (@HAdd.hAdd (TVA.Ptr TVA.DType.f32) TVA.I32 (TVA.Ptr TVA.DType.f32)
      (@TVA.instHAddPtrIntV TVA.DType.f32 Bool.true (@OfNat.ofNat Nat (nat_lit 32) (instOfNatNat (nat_lit 32)))) M
      (@HMul.hMul TVA.I32 TVA.I32 TVA.I32
