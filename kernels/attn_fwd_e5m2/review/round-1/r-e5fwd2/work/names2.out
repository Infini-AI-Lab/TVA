fun M a b o =>
  @HAdd.hAdd (TVA.Ptr TVA.DType.f32)
    (TVA.Tensor (@List.cons Nat (@OfNat.ofNat Nat (nat_lit 128) (instOfNatNat (nat_lit 128))) (@List.nil Nat)) TVA.I32)
