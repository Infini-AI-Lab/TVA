def TVA.TensorDesc.ptrsAt : {d : TVA.DType} →
  {bs : TVA.Shape} → TVA.TensorDesc d → (TVA.Idx bs → ℕ → ℤ) → TVA.Tensor bs (TVA.Ptr d) :=
fun {d} {bs} D c => { get := fun i => D.base.offset (D.elemAt (c i)) }
def TVA.TensorDesc.maskAt : {d : TVA.DType} →
  {bs : TVA.Shape} → TVA.TensorDesc d → (TVA.Idx bs → ℕ → ℤ) → TVA.Tensor bs Bool :=
fun {d} {bs} D c => { get := fun i => D.inbAt (c i) }
def TVA.TensorDesc.inbAt : {d : TVA.DType} → TVA.TensorDesc d → (ℕ → ℤ) → Bool :=
fun {d} D c => Decidable.decide (∀ k < D.rank, 0 ≤ c k ∧ c k < ↑(D.shape.getD k 0))
def TVA.TensorDesc.coord : List ℤ → {bs : TVA.Shape} → TVA.Idx bs → ℕ → ℤ :=
fun offs {bs} i k => offs.getD k 0 + ↑(i.coord k)
def TVA.TensorDesc.rank : {d : TVA.DType} → TVA.TensorDesc d → ℕ :=
fun {d} D => D.shape.length
def TVA.tl.pad : {s : TVA.Shape} →
  {d : TVA.DType} → TVA.Padding → (TVA.Idx s → Bool) → TVA.Tensor s d.Val → TVA.Prog (TVA.Tensor s d.Val) :=
fun {s} {d} p inb v =>
  TVA.Prog.pick (fun r => ∀ (i : TVA.Idx s), if inb i = Bool.true then r.get i = v.get i else p.Holds (r.get i))
    TVA.Prog.ret
def Kernels.AttnFwdE5m2.descArgV : Kernels.AttnFwdE5m2.Inst → Kernels.AttnFwdE5m2.DescArg :=
fun d =>
  if d.warp_specialize = Bool.true then Kernels.AttnFwdE5m2.DescArg.ptr (d.v.ptr 0)
  else
    Kernels.AttnFwdE5m2.DescArg.host
      { base := d.v.ptr 0, shape := [d.HEAD_DIM, Kernels.AttnFwdE5m2.rows d], strides := [d.N_CTX, 1],
        block := [d.HEAD_DIM, 64] }
def Kernels.AttnFwdE5m2.descArg : Kernels.AttnFwdE5m2.Inst → TVA.Buf TVA.DType.f8e5 → ℕ → Kernels.AttnFwdE5m2.DescArg :=
fun d b BM =>
  if d.warp_specialize = Bool.true then Kernels.AttnFwdE5m2.DescArg.ptr (b.ptr 0)
  else
    Kernels.AttnFwdE5m2.DescArg.host
      { base := b.ptr 0, shape := [Kernels.AttnFwdE5m2.rows d, d.HEAD_DIM], strides := [d.HEAD_DIM, 1],
        block := [BM, d.HEAD_DIM] }
def Kernels.AttnFwdE5m2.model : Kernels.AttnFwdE5m2.Inst → TVA.Kernel :=
fun d =>
  Kernels.AttnFwdE5m2.attn_fwd (TVA.FloatV.hostF32 d.sm_scale) (d.M.ptr 0) (TVA.IntV.ofNat d.Z) (TVA.IntV.ofNat d.H)
    (Kernels.AttnFwdE5m2.descArg d d.q 128) (Kernels.AttnFwdE5m2.descArg d d.k 64) (Kernels.AttnFwdE5m2.descArgV d)
    (Kernels.AttnFwdE5m2.descArg d d.o 128) (TVA.IntV.ofNat d.N_CTX) d.HEAD_DIM 128 64
    (if d.causal = Bool.true then 3 else 1)
def Kernels.AttnFwdE5m2.launch : Kernels.AttnFwdE5m2.Inst → TVA.Launch :=
fun d =>
  { grid := ![(d.N_CTX + 127) / 128, d.Z * d.H, 1],
    blocks := [[128], [64], [128, 1], [1, 64], [128, 64], [d.HEAD_DIM, 64], [64, d.HEAD_DIM], [128, d.HEAD_DIM]] }
structure TVA.Launch : Type
number of parameters: 0
fields:
  TVA.Launch.grid : Fin 3 → ℕ
  TVA.Launch.fusion : Bool :=
    Bool.true
  TVA.Launch.debug : Bool :=
    Bool.false
  TVA.Launch.numCtas : ℕ :=
    1
  TVA.Launch.pdl : Bool :=
    Bool.false
  TVA.Launch.blocks : List TVA.Shape
constructor:
  TVA.Launch.mk (grid : Fin 3 → ℕ) (fusion debug : Bool) (numCtas : ℕ) (pdl : Bool) (blocks : List TVA.Shape) :
    TVA.Launch
structure TVA.Kernel : Type 1
number of parameters: 0
fields:
  TVA.Kernel.body : TVA.Ctx → TVA.Prog Unit
constructor:
  TVA.Kernel.mk (body : TVA.Ctx → TVA.Prog Unit) : TVA.Kernel
def TVA.FloatV.hostF32 : TVA.F64 → TVA.F32 :=
fun c => if TVA.FloatV.isNaN c = Bool.true then TVA.FloatV.nanNarrow c else TVA.FloatV.cvt c
def TVA.tl.forRange : {σ : Type} →
  {sg : Bool} →
    {w : ℕ} → TVA.IntV sg w → TVA.IntV sg w → TVA.IntV sg w → σ → (TVA.IntV sg w → σ → TVA.Prog σ) → TVA.Prog σ :=
fun {σ} {sg} {w} lo hi step init body =>
  if TVA.tl.RangeOk lo hi step then
    TVA.tl.forN (TVA.tl.tripCount lo.toInt hi.toInt step.toInt)
      (fun t => body (TVA.IntV.ofInt (lo.toInt + ↑t * step.toInt))) init
  else TVA.Prog.ub
def TVA.tl.multiple_of1 : {β : Type} → [TVA.HintVal β] → β → ℕ → TVA.Prog β :=
fun {β} [TVA.HintVal β] x v => TVA.Prog.pick (fun y => y = x ∧ ↑v ∣ TVA.HintVal.val x) TVA.Prog.ret
def TVA.tl.cvt8 : {s : TVA.Shape} →
  {f g : TVA.Math.Float.Format} →
    TVA.Tensor s (TVA.FloatV f) →
      optParam TVA.Math.Float.RoundMode TVA.Math.Float.RoundMode.rn → TVA.Prog (TVA.Tensor s (TVA.FloatV g)) :=
fun {s} {f g} x rnd =>
  TVA.Prog.pick
    (fun x =>
      (f = TVA.Math.Float.Format.binary16 ∨ f = TVA.Math.Float.Format.bfloat16 ∨ f = TVA.Math.Float.Format.binary32) ∧
        g.F8 ∧ TVA.tl.RoundOk f g rnd)
    fun x_1 =>
    TVA.Prog.env fun e => TVA.Prog.pick (fun r => ∀ (i : TVA.Idx s), e.P.cvt f g rnd (x.get i) (r.get i)) TVA.Prog.ret
def TVA.tl.dot : (cfg : TVA.DotCfg) →
  {M N K : ℕ} →
    TVA.Tensor [M, K] cfg.a.Val →
      TVA.Tensor [K, N] cfg.b.Val → TVA.Tensor [M, N] cfg.acc.Val → TVA.Prog (TVA.Tensor [M, N] cfg.acc.Val) :=
fun cfg {M N K} a b acc => TVA.Prog.env fun e => TVA.Prog.pick (e.P.dot cfg a b acc) TVA.Prog.ret
def TVA.tl.max1 : {f : TVA.Math.Float.Format} →
  {m n : ℕ} → Bool → TVA.Tensor [m, n] (TVA.FloatV f) → TVA.Prog (TVA.Tensor [m] (TVA.FloatV f)) :=
fun {f} {m n} isMax x =>
  TVA.Prog.pick
    (fun r =>
      ∀ (i : Fin m),
        ∃ t,
          TVA.Tree.Covers n t ∧
            TVA.Tree.Eval (TVA.FloatV.MaxRel isMax) (fun j => if h : j < n then x.get2 i ⟨j, h⟩ else Inhabited.default)
              t (r.get1 i))
    TVA.Prog.ret
def TVA.tl.mul_add : {s : TVA.Shape} →
  {f : TVA.Math.Float.Format} →
    TVA.Tensor s (TVA.FloatV f) →
      TVA.Tensor s (TVA.FloatV f) → TVA.Tensor s (TVA.FloatV f) → TVA.Prog (TVA.Tensor s (TVA.FloatV f)) :=
fun {s} {f} a b c =>
  TVA.Prog.env fun e =>
    TVA.Prog.pick
      (fun r =>
        ∀ (i : TVA.Idx s),
          (((a.get i).mul (b.get i)).add (c.get i)).NaNEq (r.get i) ∨
            e.fusion = Bool.true ∧ ((a.get i).fma (b.get i) (c.get i)).NaNEq (r.get i))
      TVA.Prog.ret
def TVA.tl.subc : {s : TVA.Shape} →
  {f : TVA.Math.Float.Format} →
    TVA.Tensor s (TVA.FloatV f) → TVA.Tensor s (TVA.FloatV f) → TVA.Prog (TVA.Tensor s (TVA.FloatV f)) :=
fun {s} {f} x y => TVA.tl.addc x (TVA.Tensor.map TVA.FloatV.neg y)
def TVA.tl.sum1 : {f : TVA.Math.Float.Format} →
  {m n : ℕ} → TVA.Tensor [m, n] (TVA.FloatV f) → TVA.Prog (TVA.Tensor [m] (TVA.FloatV f)) :=
fun {f} {m n} x => TVA.tl.sum1With Bool.false x
def TVA.tl.store : {s : TVA.Shape} →
  {d : TVA.DType} →
    TVA.Tensor s (TVA.Ptr d) → TVA.Tensor s d.Val → optParam (Option (TVA.Tensor s Bool)) Option.none → TVA.Prog Unit :=
fun {s} {d} ptrs vals mask => TVA.Prog.store d s (TVA.tl.addrs ptrs mask) vals (TVA.Prog.ret ())
def TVA.tl.program_id : TVA.Ctx → Fin 3 → TVA.I32 :=
fun c axis => TVA.IntV.ofNat (c.pid axis)
def TVA.Tensor.le : {s : TVA.Shape} →
  {sg : Bool} → {w : ℕ} → TVA.Tensor s (TVA.IntV sg w) → TVA.Tensor s (TVA.IntV sg w) → TVA.Tensor s Bool :=
fun {s} {sg} {w} x y => TVA.Tensor.map2 TVA.IntV.le x y
def TVA.Tensor.where_ : {s : TVA.Shape} →
  {α : Type} → TVA.Tensor s Bool → TVA.Tensor s α → TVA.Tensor s α → TVA.Tensor s α :=
fun {s} {α} c x y => { get := fun i => if c.get i = Bool.true then x.get i else y.get i }
def TVA.IntV.cast : {s : Bool} → {w : ℕ} → {s' : Bool} → {w' : ℕ} → TVA.IntV s w → TVA.IntV s' w' :=
fun {s} {w} {s'} {w'} a =>
  { bits := if s = Bool.true then BitVec.signExtend w' a.bits else BitVec.zeroExtend w' a.bits }
def TVA.tl.idiv : {s : TVA.Shape} →
  {sg : Bool} →
    {w : ℕ} → TVA.Tensor s (TVA.IntV sg w) → TVA.Tensor s (TVA.IntV sg w) → TVA.Prog (TVA.Tensor s (TVA.IntV sg w)) :=
fun {s} {sg} {w} x y =>
  TVA.Prog.pick (fun r => ∀ (i : TVA.Idx s), (x.get i).div? (y.get i) = Option.some (r.get i)) TVA.Prog.ret
def TVA.tl.irem : {s : TVA.Shape} →
  {sg : Bool} →
    {w : ℕ} → TVA.Tensor s (TVA.IntV sg w) → TVA.Tensor s (TVA.IntV sg w) → TVA.Prog (TVA.Tensor s (TVA.IntV sg w)) :=
fun {s} {sg} {w} x y =>
  TVA.Prog.pick (fun r => ∀ (i : TVA.Idx s), (x.get i).rem? (y.get i) = Option.some (r.get i)) TVA.Prog.ret
@[reducible] def TVA.bc : {s : TVA.Shape} → {α : Type} → α → TVA.Tensor s α :=
fun {s} {α} a => TVA.Tensor.full a
def TVA.Tensor.col : {α : Type} → {m : ℕ} → TVA.Tensor [m] α → (n : ℕ) → TVA.Tensor [m, n] α :=
fun {α} {m} x n => TVA.Tensor.of2 fun i x_1 => x.get1 i
def TVA.Tensor.row : {α : Type} → {n : ℕ} → TVA.Tensor [n] α → (m : ℕ) → TVA.Tensor [m, n] α :=
fun {α} {n} x m => TVA.Tensor.of2 fun x_1 j => x.get1 j
