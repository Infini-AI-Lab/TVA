theorem Kernels.StreamKMatmul.streamk_matmul_kernel._proof_1 : NeZero (2 + 1) :=
Nat.instNeZeroSucc
@TVA.shared : ∀ {k : TVA.Kernel} {L : TVA.Launch} {E : TVA.Env} {init : TVA.Mem} {R W : Fin L.size → Set ℤ}
  {C : Set (TVA.DType × ℤ)} {Q : Fin L.size → List TVA.AtomicStep → TVA.Mem → Prop},
  (∀ (i : Fin L.size), TVA.SafeA E (R i) (W i) C (fun x log m => Q i log m) [] init (k.body (L.ctx ↑i))) →
    (∀ (i : Fin L.size), TVA.PermInv fun x log m => Q i log m) →
      (∀ (i j : Fin L.size), i ≠ j → Disjoint (W i) (R j ∪ W j)) →
        (∀ (i : Fin L.size), Disjoint (R i) (W i)) →
          (∀ (i : Fin L.size), Disjoint (TVA.cellBytes C) (R i ∪ W i)) →
            (∀ c ∈ C, ∀ c' ∈ C, (TVA.Mem.span c.1 c.2 ∩ TVA.Mem.span c'.1 c'.2).Nonempty → c = c') →
              (∀ x ∈ TVA.cellBytes C, init x ≠ Option.none) →
                TVA.WellBehaved E k L init ∧
                  ∀ (o : TVA.SemOutcome),
                    TVA.Outcomes E k L init o →
                      ∃ fin,
                        o = TVA.SemOutcome.ok fin ∧
                          ∃ G,
                            (∀ (i : Fin L.size), ∃ m, Q i (TVA.proj G i) m ∧ ∀ x ∈ R i ∪ W i, fin x = m x) ∧
                              (∃ mA, TVA.Replay init (List.map Prod.snd G) mA ∧ ∀ x ∈ TVA.cellBytes C, fin x = mA x) ∧
                                ∀ x ∉ TVA.cellBytes C, (∀ (i : Fin L.size), x ∉ W i) → fin x = init x
