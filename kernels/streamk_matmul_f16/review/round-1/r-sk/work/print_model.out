def Kernels.StreamKMatmul.streamk_matmul_kernel : TVA.Ptr TVA.DType.f16 →
  TVA.Ptr TVA.DType.f16 →
    TVA.Ptr TVA.DType.f32 →
      TVA.I32 →
        TVA.I32 →
          TVA.I32 →
            TVA.I32 →
              TVA.I32 → TVA.I32 → TVA.I32 → TVA.I32 → TVA.I32 → TVA.I32 → TVA.I32 → Nat → Nat → Nat → TVA.Kernel :=
fun a_ptr b_ptr c_ptr M N K stride_am stride_ak stride_bk stride_bn stride_cm stride_cn iters_per_program total_iters
    BLOCK_M BLOCK_N BLOCK_K =>
  {
    body := fun ctx =>
      have pid := TVA.tl.program_id ctx 0;
      Bind.bind
        (TVA.tl.idiv (TVA.Tensor.scalar (HAdd.hAdd N (TVA.IntV.ofNat (HSub.hSub BLOCK_N 1))))
          (TVA.Tensor.scalar (TVA.IntV.ofNat BLOCK_N)))
        fun __do_lift =>
        have num_pid_n := __do_lift.item;
        Bind.bind
          (TVA.tl.idiv (TVA.Tensor.scalar (HAdd.hAdd K (TVA.IntV.ofNat (HSub.hSub BLOCK_K 1))))
            (TVA.Tensor.scalar (TVA.IntV.ofNat BLOCK_K)))
          fun __do_lift =>
          have iters_per_tile := __do_lift.item;
          have it := HMul.hMul pid iters_per_program;
          have «end» :=
            (TVA.tl.iminimum (TVA.Tensor.scalar (HAdd.hAdd it iters_per_program)) (TVA.Tensor.scalar total_iters)).item;
          Bind.bind
            (TVA.tl.whileLoop it (fun it => Pure.pure (TVA.IntV.lt it «end»)) fun it =>
              Bind.bind (TVA.tl.idiv (TVA.Tensor.scalar it) (TVA.Tensor.scalar iters_per_tile)) fun __do_lift =>
                have tile := __do_lift.item;
                have k_first := HSub.hSub it (HMul.hMul tile iters_per_tile);
                have k_last :=
                  (TVA.tl.iminimum (TVA.Tensor.scalar iters_per_tile)
                      (TVA.Tensor.scalar (HAdd.hAdd k_first (HSub.hSub «end» it)))).item;
                Bind.bind (TVA.tl.idiv (TVA.Tensor.scalar tile) (TVA.Tensor.scalar num_pid_n)) fun __do_lift =>
                  have pid_m := __do_lift.item;
                  Bind.bind (TVA.tl.irem (TVA.Tensor.scalar tile) (TVA.Tensor.scalar num_pid_n)) fun __do_lift =>
                    have pid_n := __do_lift.item;
                    have offs_m := HAdd.hAdd (HMul.hMul pid_m (TVA.IntV.ofNat BLOCK_M)) (TVA.tl.arange 0 BLOCK_M);
                    have offs_n := HAdd.hAdd (HMul.hMul pid_n (TVA.IntV.ofNat BLOCK_N)) (TVA.tl.arange 0 BLOCK_N);
                    have acc := TVA.tl.zeros (List.cons BLOCK_M (List.cons BLOCK_N List.nil)) TVA.DType.f32;
                    Bind.bind
                      (TVA.tl.forRange k_first k_last (TVA.IntV.ofInt 1) acc fun kk acc =>
                        have offs_k := HAdd.hAdd (HMul.hMul kk (TVA.IntV.ofNat BLOCK_K)) (TVA.tl.arange 0 BLOCK_K);
                        Bind.bind
                          (TVA.tl.convert TVA.DType.f32 TVA.DType.f16
                            (TVA.tl.full (List.cons BLOCK_M (List.cons BLOCK_K List.nil)) (TVA.FloatV.ofPat 0).litF32))
                          fun __do_lift =>
                          Bind.bind
                            (TVA.tl.load
                              (HAdd.hAdd (HAdd.hAdd a_ptr (HMul.hMul (offs_m.col BLOCK_K) stride_am))
                                (HMul.hMul (offs_k.row BLOCK_M) stride_ak))
                              (Option.some (((offs_m.col BLOCK_K).ltS M).and ((offs_k.row BLOCK_M).ltS K)))
                              (Option.some __do_lift))
                            fun a =>
                            Bind.bind
                              (TVA.tl.convert TVA.DType.f32 TVA.DType.f16
                                (TVA.tl.full (List.cons BLOCK_K (List.cons BLOCK_N List.nil))
                                  (TVA.FloatV.ofPat 0).litF32))
                              fun __do_lift =>
                              Bind.bind
                                (TVA.tl.load
                                  (HAdd.hAdd (HAdd.hAdd b_ptr (HMul.hMul (offs_k.col BLOCK_N) stride_bk))
                                    (HMul.hMul (offs_n.row BLOCK_K) stride_bn))
                                  (Option.some (((offs_k.col BLOCK_N).ltS K).and ((offs_n.row BLOCK_K).ltS N)))
                                  (Option.some __do_lift))
                                fun b =>
                                TVA.tl.dot { a := TVA.DType.f16, b := TVA.DType.f16, acc := TVA.DType.f32 } a b acc)
                      fun acc =>
                      have c_ptrs :=
                        HAdd.hAdd (HAdd.hAdd c_ptr (HMul.hMul (offs_m.col BLOCK_N) stride_cm))
                          (HMul.hMul (offs_n.row BLOCK_M) stride_cn);
                      have c_mask := ((offs_m.col BLOCK_N).ltS M).and ((offs_n.row BLOCK_M).ltS N);
                      have __do_jp := fun __r => Pure.pure (HAdd.hAdd it (HSub.hSub k_last k_first));
                      ite (Eq ((TVA.IntV.eq k_first (TVA.IntV.ofInt 0)).and (k_last.eq iters_per_tile)) Bool.true)
                        (Bind.bind (TVA.tl.store c_ptrs acc (Option.some c_mask)) fun __r => __do_jp __r)
                        (Bind.bind (TVA.tl.atomic_add c_ptrs acc (Option.some c_mask)) fun __x => __do_jp Unit.unit))
            fun _it => Pure.pure Unit.unit }
def Kernels.StreamKMatmul.model : Kernels.StreamKMatmul.Inst → TVA.Kernel :=
fun d =>
  Kernels.StreamKMatmul.streamk_matmul_kernel (d.a.ptr 0) (d.b.ptr 0) (d.c.ptr 0) (TVA.IntV.ofNat d.M)
    (TVA.IntV.ofNat d.N) (TVA.IntV.ofNat d.K) (TVA.IntV.ofNat d.stride_am) (TVA.IntV.ofNat d.stride_ak)
    (TVA.IntV.ofNat d.stride_bk) (TVA.IntV.ofNat d.stride_bn) (TVA.IntV.ofNat d.stride_cm) (TVA.IntV.ofNat d.stride_cn)
    (TVA.IntV.ofNat d.iters_per_program) (TVA.IntV.ofNat d.total_iters) 128 128 64
def Kernels.StreamKMatmul.launch : Kernels.StreamKMatmul.Inst → TVA.Launch :=
fun d =>
  TVA.Launch.grid1 d.num_programs
    (List.cons (List.cons 128 List.nil)
      (List.cons (List.cons 64 List.nil)
        (List.cons (List.cons 128 (List.cons 1 List.nil))
          (List.cons (List.cons 1 (List.cons 64 List.nil))
            (List.cons (List.cons 128 (List.cons 64 List.nil))
              (List.cons (List.cons 64 (List.cons 1 List.nil))
                (List.cons (List.cons 1 (List.cons 128 List.nil))
                  (List.cons (List.cons 64 (List.cons 128 List.nil))
                    (List.cons (List.cons 128 (List.cons 128 List.nil)) List.nil)))))))))
structure Kernels.StreamKMatmul.Assumptions (K : TVA.Claim.Behaviour Kernels.StreamKMatmul.Inst) (P : TVA.Platform) :
  Prop
number of parameters: 2
fields:
  Kernels.StreamKMatmul.Assumptions.faithful : ∀ (d : Kernels.StreamKMatmul.Inst),
      d.ok → TVA.Rules.Compiler.Faithful P (Kernels.StreamKMatmul.model d) (Kernels.StreamKMatmul.launch d) (K d)
  Kernels.StreamKMatmul.Assumptions.dot : TVA.Rules.Num.DotF16 P
  Kernels.StreamKMatmul.Assumptions.dot_total : TVA.Rules.Num.DotTotal P
      { a := TVA.DType.f16, b := TVA.DType.f16, acc := TVA.DType.f32 }
  Kernels.StreamKMatmul.Assumptions.atomic : TVA.Rules.Num.AtomicAddF32 P
  Kernels.StreamKMatmul.Assumptions.atomic_total : TVA.Rules.Num.AtomicAddTotal P TVA.Math.Float.Format.binary32
constructor:
  Kernels.StreamKMatmul.Assumptions.mk {K : TVA.Claim.Behaviour Kernels.StreamKMatmul.Inst} {P : TVA.Platform}
    (faithful :
      ∀ (d : Kernels.StreamKMatmul.Inst),
        d.ok → TVA.Rules.Compiler.Faithful P (Kernels.StreamKMatmul.model d) (Kernels.StreamKMatmul.launch d) (K d))
    (dot : TVA.Rules.Num.DotF16 P)
    (dot_total : TVA.Rules.Num.DotTotal P { a := TVA.DType.f16, b := TVA.DType.f16, acc := TVA.DType.f32 })
    (atomic : TVA.Rules.Num.AtomicAddF32 P)
    (atomic_total : TVA.Rules.Num.AtomicAddTotal P TVA.Math.Float.Format.binary32) :
    Kernels.StreamKMatmul.Assumptions K P
'Kernels.StreamKMatmul.main' depends on axioms: [propext, Classical.choice, Quot.sound]
