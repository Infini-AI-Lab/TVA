'Kernels.PagedAttention.main' depends on axioms: [propext, Classical.choice, Quot.sound]
'Kernels.PagedAttention.consistent' depends on axioms: [propext, Classical.choice, Quot.sound]
'Kernels.PagedAttention.satisfiable' depends on axioms: [propext, Classical.choice, Quot.sound]
def Kernels.PagedAttention.paged_attention_kernel : TVA.Ptr TVA.DType.f16 →
  TVA.Ptr TVA.DType.f16 →
    TVA.Ptr TVA.DType.f16 →
      TVA.Ptr TVA.DType.f16 →
        TVA.Ptr TVA.DType.i32 →
          TVA.Ptr TVA.DType.i32 →
            TVA.F32 →
              TVA.I32 →
                TVA.I32 → TVA.I32 → TVA.I32 → TVA.I32 → TVA.I32 → TVA.I32 → TVA.I32 → Nat → Nat → Nat → TVA.Kernel :=
fun out_ptr q_ptr k_cache_ptr v_cache_ptr block_tables_ptr seq_lens_ptr scale stride_qs stride_qh stride_kp stride_kt
    stride_kh stride_bs stride_os stride_oh QUERIES_PER_KV PAGE_SIZE HEAD_DIM =>
  {
    body := fun ctx =>
      have seq := TVA.tl.program_id ctx 0;
      have head := TVA.tl.program_id ctx 1;
      Bind.bind (TVA.tl.idiv (TVA.Tensor.scalar head) (TVA.Tensor.scalar (TVA.IntV.ofNat QUERIES_PER_KV)))
        fun __do_lift =>
        have kv_head := __do_lift.item;
        Bind.bind (TVA.tl.load1 (HAdd.hAdd seq_lens_ptr seq)) fun seq_len =>
          have offs_t := TVA.tl.arange 0 PAGE_SIZE;
          have offs_d := TVA.tl.arange 0 HEAD_DIM;
          Bind.bind
            (TVA.tl.load
              (HAdd.hAdd (HAdd.hAdd (HAdd.hAdd q_ptr (HMul.hMul seq stride_qs)) (HMul.hMul head stride_qh)) offs_d))
            fun __do_lift =>
            Bind.bind (TVA.tl.cvt __do_lift) fun q =>
              have m_i := (TVA.FloatV.ofPat 18442240474082181120).litF32;
              have l_i := (TVA.FloatV.ofPat 0).litF32;
              have acc := TVA.tl.zeros (List.cons HEAD_DIM List.nil) TVA.DType.f32;
              Bind.bind
                (TVA.tl.idiv (TVA.Tensor.scalar (HAdd.hAdd seq_len (TVA.IntV.ofNat (HSub.hSub PAGE_SIZE 1))))
                  (TVA.Tensor.scalar (TVA.IntV.ofNat PAGE_SIZE)))
                fun __do_lift =>
                Bind.bind
                  (TVA.tl.forRange (TVA.IntV.ofInt 0) __do_lift.item (TVA.IntV.ofInt 1) (Prod.mk acc (Prod.mk l_i m_i))
                    fun j x =>
                    Kernels.PagedAttention.paged_attention_kernel.match_1 HEAD_DIM
                      (fun x =>
                        TVA.Prog
                          (Prod (TVA.Tensor (List.cons HEAD_DIM List.nil) TVA.DType.f32.Val) (Prod TVA.F32 TVA.F32)))
                      x fun acc l_i m_i =>
                      Bind.bind (TVA.tl.load1 (HAdd.hAdd (HAdd.hAdd block_tables_ptr (HMul.hMul seq stride_bs)) j))
                        fun __do_lift =>
                        Bind.bind (TVA.tl.convert TVA.DType.i32 TVA.DType.i64 (TVA.Tensor.scalar __do_lift))
                          fun __do_lift =>
                          have page := __do_lift.item;
                          have mask := (HAdd.hAdd (HMul.hMul j (TVA.IntV.ofNat PAGE_SIZE)) offs_t).ltS seq_len;
                          Bind.bind (TVA.tl.convert TVA.DType.i32 TVA.DType.i64 (TVA.Tensor.scalar stride_kp))
                            fun __do_lift =>
                            Bind.bind
                              (TVA.tl.convert TVA.DType.i32 TVA.DType.i64 (HMul.hMul (offs_t.col HEAD_DIM) stride_kt))
                              fun __do_lift_1 =>
                              Bind.bind
                                (TVA.tl.convert TVA.DType.i32 TVA.DType.i64
                                  (TVA.Tensor.scalar (HMul.hMul kv_head stride_kh)))
                                fun __do_lift_2 =>
                                Bind.bind (TVA.tl.convert TVA.DType.i32 TVA.DType.i64 (offs_d.row PAGE_SIZE))
                                  fun __do_lift_3 =>
                                  have kv_offs :=
                                    HAdd.hAdd
                                      (HAdd.hAdd (HAdd.hAdd (HMul.hMul page __do_lift.item) __do_lift_1)
                                        __do_lift_2.item)
                                      __do_lift_3;
                                  Bind.bind
                                    (TVA.tl.convert TVA.DType.f32 TVA.DType.f16
                                      (TVA.tl.full (List.cons PAGE_SIZE (List.cons HEAD_DIM List.nil))
                                        (TVA.FloatV.ofPat 0).litF32))
                                    fun __do_lift =>
                                    Bind.bind
                                      (TVA.tl.load (HAdd.hAdd k_cache_ptr kv_offs) (Option.some (mask.col HEAD_DIM))
                                        (Option.some __do_lift))
                                      fun __do_lift =>
                                      Bind.bind (TVA.tl.cvt __do_lift) fun k =>
                                        Bind.bind (TVA.tl.mul k (q.row PAGE_SIZE)) fun __do_lift =>
                                          Bind.bind (TVA.tl.sum1c __do_lift) fun __do_lift => ⋯)
                  fun __x =>
                  Kernels.PagedAttention.paged_attention_kernel.match_1 HEAD_DIM (fun x => TVA.Prog Unit) __x
                    fun acc l_i _m_i =>
                    Bind.bind (TVA.tl.div acc (TVA.bc l_i)) fun out =>
                      Bind.bind (TVA.tl.cvt out) fun o16 =>
                        TVA.tl.store
                          (HAdd.hAdd
                            (HAdd.hAdd (HAdd.hAdd out_ptr (HMul.hMul seq stride_os)) (HMul.hMul head stride_oh)) offs_d)
                          o16 }
def Kernels.PagedAttention.model : Kernels.PagedAttention.Inst → TVA.Kernel :=
fun d =>
  Kernels.PagedAttention.paged_attention_kernel (d.out.ptr 0) (d.q.ptr 0) (d.k_cache.ptr 0) (d.v_cache.ptr 0)
    (d.block_tables.ptr 0) (d.seq_lens.ptr 0) (TVA.FloatV.hostF32 d.scale) (TVA.IntV.ofNat d.stride_qs)
    (TVA.IntV.ofNat d.stride_qh) (TVA.IntV.ofNat d.stride_kp) (TVA.IntV.ofNat d.stride_kt) (TVA.IntV.ofNat d.stride_kh)
    (TVA.IntV.ofNat d.stride_bs) (TVA.IntV.ofNat d.stride_os) (TVA.IntV.ofNat d.stride_oh)
    (Kernels.PagedAttention.qpk d) d.PAGE_SIZE d.HEAD_DIM
def Kernels.PagedAttention.launch : Kernels.PagedAttention.Inst → TVA.Launch :=
fun d =>
  { grid := Matrix.vecCons d.num_seqs (Matrix.vecCons d.num_heads (Matrix.vecCons 1 Matrix.vecEmpty)),
    blocks :=
      List.cons (List.cons d.PAGE_SIZE List.nil)
        (List.cons (List.cons d.HEAD_DIM List.nil)
          (List.cons (List.cons d.PAGE_SIZE (List.cons 1 List.nil))
            (List.cons (List.cons 1 (List.cons d.HEAD_DIM List.nil))
              (List.cons (List.cons d.PAGE_SIZE (List.cons d.HEAD_DIM List.nil)) List.nil)))) }
