  Kernels.PagedAttention.Assumptions.exp_ninf : TVA.Rules.Num.ExpF32NegInf P
  Kernels.PagedAttention.Assumptions.exp_total : TVA.Rules.Num.MathTotal P TVA.MathFn.exp TVA.Math.Float.Format.binary32
  Kernels.PagedAttention.Assumptions.div_full : TVA.Rules.Num.DivFull P
  Kernels.PagedAttention.Assumptions.div_total : TVA.Rules.Num.DivTotal P TVA.Math.Float.Format.binary32
constructor:
  Kernels.PagedAttention.Assumptions.mk {K : TVA.Claim.Behaviour Kernels.PagedAttention.Inst} {P : TVA.Platform}
    (faithful :
      ∀ (d : Kernels.PagedAttention.Inst),
        d.ok → TVA.Rules.Compiler.Faithful P (Kernels.PagedAttention.model d) (Kernels.PagedAttention.launch d) (K d))
    (exp_acc : TVA.Rules.Num.ExpF32 P) (exp_ninf : TVA.Rules.Num.ExpF32NegInf P)
    (exp_total : TVA.Rules.Num.MathTotal P TVA.MathFn.exp TVA.Math.Float.Format.binary32)
    (div_full : TVA.Rules.Num.DivFull P) (div_total : TVA.Rules.Num.DivTotal P TVA.Math.Float.Format.binary32) :
    Kernels.PagedAttention.Assumptions K P
