| float16 | mma.sync | 16 | t <= 23 | s <= 24 | 1.19e-07 |
| bfloat16 | mma.sync | 16 | t <= 23 | s <= 24 | 1.19e-07 |
| bfloat16 | mma.sync | 16 | t <= 23 | s <= 24 | 1.19e-07 |
| float8e4nv | mma.sync | 32 | t <= 9 | s <= 13 | 0 |
