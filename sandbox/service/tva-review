#!/usr/bin/env python3
"""tva-review: the prover's client of the review service (PROTOCOL.md).

  tva-review status            the round, the open findings, the last submission, and what to do next
  tva-review submit [--dry-run]
                               send the kernel's files (and, from round 2, your response) for review;
                               returns at once: then run `tva-review wait`
  tva-review wait [SECONDS]    wait for the submission under review (at most SECONDS, 540 by default);
                               when it is done, copy the record into your kernel folder. Exit 0 when the
                               service is idle again, 3 when the review is still running
  tva-review log [JOB]         the service's log of a submission (the gate's output, the outcome)
  tva-review fetch             copy the record (REVIEW.md, claim.md, gate.json, review/) into your kernel folder

A submission holds lean/**.lean, README.md, model-map.json, kernel.json and review/round-N/prover/*
(N the current round), from ~/fpv/tva/kernels/<kernel>/.
"""
import io
import json
import os
import sys
import tarfile
import urllib.error
import urllib.request

TASK = json.load(open("/etc/tva-sandbox/task.json"))
K = TASK["kernel"]
URL = os.environ.get("TVA_REVIEW_URL", "http://reviewer:8765")
KD = os.path.join(os.environ.get("TVA_ROOT", "/home/tva/fpv/tva"), "kernels", K)
NOTE_EXT = (".json", ".md", ".txt", ".lean", ".py")
SYNC = ("REVIEW.md", "claim.md", "gate.json", "review")


def call(method, path, data=None, timeout=60, raw=False):
    req = urllib.request.Request(URL + path, data=data, method=method,
                                 headers={"Content-Type": "application/x-tar"} if data is not None else {})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            body = r.read()
            return r.status, body if raw else json.loads(body)
    except urllib.error.HTTPError as e:
        body = e.read()
        try:
            return e.code, json.loads(body)
        except ValueError:
            return e.code, {"error": body.decode(errors="replace")}
    except (urllib.error.URLError, OSError) as e:
        sys.exit(f"cannot reach the review service at {URL}: {e}")


def show(st):
    sub = st.get("submissions", {})
    print(f"kernel {st['kernel']}: {st['status']}" + (f", round {st['round']}" if "round" in st else "") +
          (f" ({st['phase']})" if st.get("phase") else ""))
    if "certificate" in st:
        print(f"certificate: {'GRANTED' if st['certificate'] else 'not yet'}" +
              (f"; gate {st['gate']}" if st.get("gate") else ""))
    if st.get("open_findings"):
        print("open findings: " + ", ".join(st["open_findings"]) + f" (REVIEW.md in kernels/{K}/ has them)")
    print(f"submissions: {sub.get('reviewed', 0)} reviewed of at most {sub.get('max_reviewed')}, "
          f"{sub.get('rejected', 0)} rejected of at most {sub.get('max_rejected')}")
    j = st.get("job")
    if j:
        line = f"last submission: job {j['id']}, {j['state']}"
        if j["state"] == "running":
            line += f" ({j.get('step', '')})"
        res = j.get("result") or {}
        if j["state"] == "done":
            if res.get("accepted") is False:
                line += f": REJECTED: {res.get('reason') or res.get('error')}"
            elif res.get("error"):
                line += f": {res['error']}"
            else:
                line += f": reviewed in round {res.get('round')}"
        print(line)
        if j["state"] == "done" and res.get("output"):
            print("\n" + res["output"] + "\n")
    print(f"next: {st['next']}")


def files_to_submit(rnd):
    out = []
    for name in ("README.md", "model-map.json", "kernel.json"):
        if os.path.isfile(os.path.join(KD, name)):
            out.append(name)
    for base, sub, ext in (("lean", "lean", (".lean",)), (f"review/round-{rnd}/prover", f"review/round-{rnd}/prover", NOTE_EXT)):
        d = os.path.join(KD, base)
        for dirpath, dirs, files in os.walk(d):
            dirs[:] = sorted(x for x in dirs if not os.path.islink(os.path.join(dirpath, x)))
            for f in sorted(files):
                p = os.path.join(dirpath, f)
                if f.endswith(ext) and os.path.isfile(p) and not os.path.islink(p):
                    out.append(os.path.relpath(p, KD))
    return out


def fetch(quiet=False):
    code, body = call("GET", "/bundle", raw=True, timeout=120)
    if code != 200:
        sys.exit(f"fetch failed ({code}): {body}")
    n = 0
    with tarfile.open(fileobj=io.BytesIO(body), mode="r:gz") as tf:
        members = [m for m in tf.getmembers() if m.name.split("/")[0] in SYNC and (m.isfile() or m.isdir())]
        tf.extractall(KD, members=members, filter="data")
        n = sum(1 for m in members if m.isfile())
    if not quiet:
        print(f"copied the record into kernels/{K}/ ({n} files: REVIEW.md, claim.md, gate.json, review/)")


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "status"
    if cmd == "status":
        show(call("GET", "/status")[1])
    elif cmd == "submit":
        st = call("GET", "/status")[1]
        if st["status"] != "ready":
            show(st)
            sys.exit(f"the service takes no submission now (status {st['status']})")
        rnd = st.get("round", 1)
        names = files_to_submit(rnd)
        print(f"submission for round {rnd}: " + ", ".join(names))
        if "--dry-run" in argv:
            return 0
        buf = io.BytesIO()
        with tarfile.open(fileobj=buf, mode="w") as tf:
            for n in names:
                tf.add(os.path.join(KD, n), arcname=n, recursive=False)
        code, res = call("POST", "/submit", data=buf.getvalue())
        if code != 202:
            sys.exit(f"submission refused ({code}): {res.get('error')}")
        print(f"submitted: job {res['job']}. The service gates it, then the reviewers review it (this takes a while). "
              "Run `tva-review wait` until it is done.")
    elif cmd == "wait":
        secs = float(argv[2]) if len(argv) > 2 else 540
        code, st = call("GET", f"/wait?timeout={min(secs, 600)}", timeout=min(secs, 600) + 60)
        if st["status"] != "busy":
            fetch(quiet=True)
        show(st)
        return 3 if st["status"] == "busy" else 0
    elif cmd == "log":
        job = argv[2] if len(argv) > 2 else ""
        code, body = call("GET", "/log" + (f"?job={job}" if job else ""), raw=True)
        print(body.decode(errors="replace") if code == 200 else body)
    elif cmd == "fetch":
        fetch()
    else:
        print(__doc__)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
