import Lean
import @MODULE@

/-! Generated by `tools/tvr.py check`; do not edit. The claim reader of TVA's review protocol
(`docs/REVIEW_PROTOCOL.md`). It reads the prover's elaborated Lean claim, never the kernel's
source: there is no translator, and the model is the prover's transcription. The `example`s fail
to elaborate when the claim does not have the protocol's shape, and the `#eval` fails when
`Assumptions` has other parameters than `K` and `P` (library issue L94); otherwise it prints one JSON
object (line prefix `TVR_JSON `) with each item's constants, their canonical texts (which `tvr`
hashes with sha256), docstrings and modules, each assumption's statement (its canonical text and
its shape), the axioms of `main`, `consistent` and `satisfiable`, and how `main` uses each
assumption. -/

open Lean Meta

/-! ## The claim's shape -/

example : ∀ (K : TVA.Claim.Behaviour @NS@.Inst) (P : TVA.Platform), @NS@.Assumptions K P → @NS@.Spec K :=
  @NS@.main
example : TVA.Claim.Consistent @NS@.Assumptions := @NS@.consistent
example : TVA.Claim.Satisfiable @NS@.Inst.ok @NS@.Pre := @NS@.satisfiable
example : ∀ K, @NS@.Spec K = TVA.Claim.Meets @NS@.Inst.ok @NS@.Pre @NS@.Post K := fun _ => rfl

/-! ## What the claim mentions -/

namespace TVR

/-- The kernel's own modules (the module prefix of its lake library). -/
def kernelModule (env : Environment) (n : Name) : Bool :=
  match env.getModuleIdxFor? n with
  | some i => (`@PREFIX@).isPrefixOf (env.header.moduleNames[i.toNat]!)
  | none => false

/-- The constants that belong to a claim: the library's, and the kernel's own (its namespace's
root, or any constant its modules declare, wherever it is named). -/
def inScope (env : Environment) (n : Name) : Bool :=
  n.getRoot == `TVA || n.getRoot == (`@NS@).getRoot || kernelModule env n

/-- A docstring with its whitespace normalised, so that a reflow changes no digest. -/
def normWs (s : String) : String := Id.run do
  let mut out : Array Char := #[]
  let mut sp := false
  for c in s.toList do
    if c.isWhitespace then sp := true
    else
      if sp && !out.isEmpty then out := out.push ' '
      sp := false
      out := out.push c
  return String.ofList out.toList

/-- The constants an item reaches: definitions are followed through their values, theorems,
axioms and opaque constants through their types only (a proof is not part of the meaning). A
structure reached brings every field's projection. `tvr` hashes the whole file of every library
module that holds one of them (library issue L36). -/
def cone (roots : Array Name) : MetaM (Array Name) := do
  let env ← getEnv
  let mut seen : NameSet := {}
  let mut out : Array Name := #[]
  let mut stack : Array Name := roots
  while h : stack.size > 0 do
    let n := stack[stack.size - 1]
    stack := stack.pop
    if seen.contains n then continue
    seen := seen.insert n
    let some ci := env.find? n | continue
    out := out.push n
    let mut used := ci.type.getUsedConstants
    match ci with
    | .defnInfo v => used := used ++ v.value.getUsedConstants
    | .inductInfo v =>
      used := used ++ v.ctors.toArray
      if let some si := getStructureInfo? env n then
        used := used ++ si.fieldInfo.map (·.projFn)
    | .ctorInfo v => used := used.push v.induct
    | _ => pure ()
    for m in used do
      if inScope env m && !seen.contains m then stack := stack.push m
  return out

/-- The constants a theorem's proof reaches inside the bundle's namespace (for assumption usage). -/
def proofCone (root : Name) (ns : Name) : MetaM NameSet := do
  let env ← getEnv
  let mut seen : NameSet := {}
  let mut stack : Array Name := #[root]
  while h : stack.size > 0 do
    let n := stack[stack.size - 1]
    stack := stack.pop
    if seen.contains n then continue
    seen := seen.insert n
    let some ci := env.find? n | continue
    let mut used := ci.type.getUsedConstants
    if let some v := ci.value? (allowOpaque := true) then used := used ++ v.getUsedConstants
    for m in used do
      if ns.isPrefixOf m && !seen.contains m then stack := stack.push m
      else seen := seen.insert m
  return seen

/-! ### Canonical text (library issue L48)

A constant's digest is the sha256 of its canonical text, computed by `tvr`. The text writes the
constant out in full: its kind, name and universe parameters, its type, its value if it is a
definition, and the kind-specific data, with every constant's name, universe level, literal and
binder kind spelled out, and bound variables as de Bruijn indices. Each atom carries its kind and a
length or a terminator, so two constants that differ other than in the names of bound variables
(which change nothing a term means) give two different texts, and sha256 makes a collision of their
digests infeasible to find. Binder names are left out, so a renamed bound variable, or a hygienic
name that an unrelated edit renumbers, re-opens nothing; so is metadata (`mdata`), which the
kernel ignores. -/

/-- `acc` followed by a string atom: its length in characters, `:`, the string. -/
def canonStr (s : String) (acc : String) : String :=
  acc ++ toString s.length ++ ":" ++ s

/-- `acc` followed by a name: `_`, then each component, `s<len>:<text>` or `n<number>;`. -/
partial def canonName (n : Name) (acc : String) : String :=
  match n with
  | .anonymous => acc.push '_'
  | .str p s => canonStr s ((canonName p acc).push 's')
  | .num p k => ((canonName p acc).push 'n' ++ toString k).push ';'

/-- `acc` followed by a universe level. -/
partial def canonLevel (l : Level) (acc : String) : String :=
  match l with
  | .zero => acc.push '0'
  | .succ l => (canonLevel l (acc ++ "(+ ")).push ')'
  | .max a b => (canonLevel b ((canonLevel a (acc ++ "(max ")).push ' ')).push ')'
  | .imax a b => (canonLevel b ((canonLevel a (acc ++ "(imax ")).push ' ')).push ')'
  | .param n => (canonName n (acc ++ "(u ")).push ')'
  | .mvar m => (canonName m.name (acc ++ "(?u ")).push ')'

def canonBinder : BinderInfo → String
  | .default => "d" | .implicit => "i" | .strictImplicit => "s" | .instImplicit => "c"

/-- `acc` followed by an expression, as a tree of tagged nodes. -/
partial def canonExpr (e : Expr) (acc : String) : String :=
  match e with
  | .bvar i => acc ++ s!"(b {i})"
  | .fvar f => (canonName f.name (acc ++ "(fv ")).push ')'
  | .mvar m => (canonName m.name (acc ++ "(mv ")).push ')'
  | .sort l => (canonLevel l (acc ++ "(S ")).push ')'
  | .const n ls => (ls.foldl (fun a l => canonLevel l (a.push ' ')) (canonName n (acc ++ "(C "))).push ')'
  | .app f a => (canonExpr a ((canonExpr f (acc ++ "(A ")).push ' ')).push ')'
  | .lam _ t b bi => (canonExpr b ((canonExpr t (acc ++ s!"(L {canonBinder bi} ")).push ' ')).push ')'
  | .forallE _ t b bi => (canonExpr b ((canonExpr t (acc ++ s!"(P {canonBinder bi} ")).push ' ')).push ')'
  | .letE _ t v b nd =>
    (canonExpr b ((canonExpr v ((canonExpr t (acc ++ s!"(E {nd} ")).push ' ')).push ' ')).push ')'
  | .lit (.natVal k) => acc ++ s!"(N {k})"
  | .lit (.strVal s) => (canonStr s (acc ++ "(T ")).push ')'
  | .mdata _ e => canonExpr e acc
  | .proj s i e => (canonExpr e ((canonName s (acc ++ "(J ")) ++ s!" {i} ")).push ')'

def canonNames (ns : List Name) (acc : String) : String :=
  (ns.foldl (fun a n => canonName n (a.push ' ')) (acc.push '[')).push ']'

def kindOf : ConstantInfo → String
  | .defnInfo _ => "def" | .thmInfo _ => "theorem" | .axiomInfo _ => "axiom"
  | .opaqueInfo _ => "opaque" | .inductInfo _ => "inductive" | .ctorInfo _ => "ctor"
  | .recInfo _ => "rec" | .quotInfo _ => "quot"

/-- A constant's canonical text: `(K <kind> <name> [<universe parameters>] <type> <data>)`, where the
data is the value of a definition (with its safety), nothing more for a theorem (its statement is its
meaning), and the structural data of the other kinds; then, for a library constant, its docstring. -/
def canonConst (ci : ConstantInfo) (doc : Option String) (trusted : Bool) : String := Id.run do
  let mut acc := canonExpr ci.type ((canonNames ci.levelParams (canonName ci.name s!"(K {kindOf ci} ")).push ' ')
  match ci with
  | .defnInfo v =>
    let safety := match v.safety with | .safe => "safe" | .unsafe => "unsafe" | .partial => "partial"
    acc := canonExpr v.value (acc ++ s!" (def {safety}) ")
  | .thmInfo _ => pure ()
  | .opaqueInfo v => acc := acc ++ s!" (opaque {v.isUnsafe})"
  | .axiomInfo v => acc := acc ++ s!" (axiom {v.isUnsafe})"
  | .inductInfo v =>
    acc := canonNames v.ctors (canonNames v.all
      (acc ++ s!" (inductive {v.numParams} {v.numIndices} {v.isRec} {v.isUnsafe} {v.isReflexive} {v.numNested}) "))
  | .ctorInfo v =>
    acc := canonName v.induct (acc ++ s!" (ctor {v.cidx} {v.numParams} {v.numFields} {v.isUnsafe}) ")
  | .recInfo v =>
    acc := canonNames v.all (acc ++ s!" (rec {v.numParams} {v.numIndices} {v.numMotives} {v.numMinors} {v.k} {v.isUnsafe}) ")
    for r in v.rules do
      acc := (canonExpr r.rhs ((canonName r.ctor (acc ++ s!" (rule {r.nfields} ")).push ' ')).push ')'
  | .quotInfo v =>
    let k := match v.kind with | .type => "type" | .ctor => "ctor" | .lift => "lift" | .ind => "ind"
    acc := acc ++ s!" (quot {k})"
  -- The library means what its docstrings say, so a library constant's text holds its docstring
  -- (whitespace normalised). This names the constant in what changed; the digest is complete without
  -- it, since `tvr` also hashes the whole file of every library module the item reaches (library
  -- issue L36).
  if trusted then acc := (canonStr (normWs (doc.getD "")) (acc ++ " (doc ")).push ')'
  return acc.push ')'

def constJson (n : Name) : MetaM Json := do
  let env ← getEnv
  let some ci := env.find? n | return Json.null
  let doc ← findDocString? env n
  let trusted := n.getRoot == `TVA
  let rng ← findDeclarationRanges? n
  let modName := match env.getModuleIdxFor? n with
    | some i => (env.header.moduleNames[i.toNat]!).toString
    | none => ""
  let rj : Json := match rng with
    | some r => Json.arr #[toJson r.range.pos.line, toJson r.range.endPos.line]
    | none => Json.null
  return Json.mkObj [("name", toJson n.toString), ("kind", toJson (kindOf ci)),
    ("module", toJson modName), ("canon", toJson (canonConst ci doc trusted)), ("range", rj),
    ("doc", match doc with | some d => toJson d | none => Json.null)]

/-- The names of the binders (`fun`, `∀`, `let`) of an expression, without the hygienic names Lean
makes itself (those have macro scopes). -/
partial def binderNames (e : Expr) : StateM (Std.HashSet Expr × NameSet) Unit := do
  if (← get).1.contains e then return
  modify fun (s, a) => (s.insert e, a)
  let note (n : Name) : StateM (Std.HashSet Expr × NameSet) Unit :=
    if n.hasMacroScopes || n.isAnonymous then pure () else modify fun (s, a) => (s, a.insert n)
  match e with
  | .lam n t b _ | .forallE n t b _ => note n; binderNames t; binderNames b
  | .letE n t v b _ => note n; binderNames t; binderNames v; binderNames b
  | .app f a => binderNames f; binderNames a
  | .mdata _ b => binderNames b
  | .proj _ _ b => binderNames b
  | _ => pure ()

/-- The text of one name component. -/
def compStr : Name → String
  | .str _ s => s
  | .num _ k => toString k
  | .anonymous => ""

/-- Whether a name has a numeric component. A kernel's source cannot spell one (an identifier's
components are words; `x.1` is a projection), so such a name is one Lean made itself: a macro
scope, a private prefix `_private.<module>.0`. These are the only names declared outside the
kernel's namespace that the namespace check exempts; a user-written `_x` or `_root_._x` is not
exempt, although `Name.isInternal` holds of it (library issue L63). -/
def leanMade : Name → Bool
  | .anonymous => false
  | .str p _ => leanMade p
  | .num _ _ => true

/-- A name component as a kernel may write it in plain ASCII: a letter or `_`, then letters,
digits, `_`, `'`, `!`, `?`. -/
def plainComponent (s : String) : Bool :=
  match s.toList with
  | c :: cs => (c.isAlpha || c == '_') && c.toNat < 128 &&
      cs.all (fun d => d.toNat < 128 && (d.isAlphanum || d == '_' || d == '\'' || d == '!' || d == '?'))
  | [] => false

end TVR

#eval show MetaM Unit from do
  let env ← getEnv
  let ns : Name := `@NS@
  let items : List (String × Array Name) := [
    ("model", #[ns ++ `model, ns ++ `launch]),
    ("conditions", #[ns ++ `Inst, ns ++ `Inst.ok, ns ++ `Pre]),
    ("spec", #[ns ++ `Post, ns ++ `Spec])]
  -- `Assumptions` must be a `structure` (library issue L106): of any other inductive type
  -- `getStructureFields` reads no field (it panics, and the reader would go on with none), so the
  -- claim would show no assumption while one constructor could hold anything, the specification too
  unless isStructure env (ns ++ `Assumptions) do
    throwError "TVR: Assumptions must be a structure (library issue L106)"
  let fields := getStructureFields env (ns ++ `Assumptions)
  -- every field is read through its projection `<ns>.Assumptions.<f>` (its statement, docstring and use by
  -- `main`); a `private` field's projection has another name, so the reader would list the field and read
  -- none of it: such a field is refused by name (library issue L112)
  for f in fields do
    unless env.contains (ns ++ `Assumptions ++ f) do
      throwError m!"TVR: the field {f} of Assumptions has no projection {ns ++ `Assumptions ++ f} (a private field?); every field must be public (library issue L112)"
  let npar ← match env.find? (ns ++ `Assumptions) with
    | some (.inductInfo v) => pure v.numParams
    | _ => throwError "Assumptions is not a structure"
  -- `Assumptions` has exactly the two parameters `(K : Claim.Behaviour Inst) (P : Platform)`, in this
  -- order, both explicit (library issue L94): every flag below finds `K` and `P` by their place among
  -- the binders of a field's projection, so a parameter before them (an instance argument, say) would
  -- make them read another binder
  let some aci := env.find? (ns ++ `Assumptions) | throwError "Assumptions is not a structure"
  let paramsOk ← forallTelescope aci.type fun ps _ => do
    let decls ← ps.mapM (·.fvarId!.getDecl)
    if h : ps.size = 2 then
      let kTy ← mkAppM ``TVA.Claim.Behaviour #[mkConst (ns ++ `Inst)]
      pure (npar == 2 && decls.all (·.binderInfo == .default) &&
        (← isDefEq (← inferType ps[0]) kTy) && (← isDefEq (← inferType ps[1]) (mkConst ``TVA.Platform)))
    else pure false
  unless paramsOk do
    throwError m!"TVR: Assumptions must have exactly the parameters (K : Claim.Behaviour Inst) (P : Platform), in this order and explicit (library issue L94); its type is {aci.type}"
  -- an assumption's roots: the constants its statement (the field's type) mentions
  let mut fitems : List (String × Array Name) := []
  for f in fields do
    let some ci := env.find? (ns ++ `Assumptions ++ f) | continue
    let roots ← forallBoundedTelescope ci.type (some (npar + 1)) fun _ b =>
      pure ((b.getUsedConstants.filter (TVR.inScope env)).push (ns ++ `Inst))
    fitems := fitems ++ [(s!"assumption:{f}", roots)]
  let items := items ++ fitems
  let mut itemJs : Array (String × Json) := #[]
  let mut all : NameSet := {}
  for (it, roots) in items do
    let c ← TVR.cone roots
    for n in c do all := all.insert n
    itemJs := itemJs.push (it, Json.mkObj [("roots", toJson (roots.map (·.toString))),
      ("cone", toJson (c.map (·.toString)))])
  let mut consts : Array Json := #[]
  for n in all.toArray do consts := consts.push (← TVR.constJson n)
  -- assumption usage by `main`
  let used ← TVR.proofCone (ns ++ `main) ns
  let mut usage : Array (String × Json) := #[]
  for f in fields do
    usage := usage.push (f.toString, toJson (used.contains (ns ++ `Assumptions ++ f)))
  let destructured := used.contains (ns ++ `Assumptions.casesOn) || used.contains (ns ++ `Assumptions.rec)
  -- axioms
  let axMain ← collectAxioms (ns ++ `main)
  let axCons ← collectAxioms (ns ++ `consistent)
  let axSat ← collectAxioms (ns ++ `satisfiable)
  -- constants declared by the bundle's modules: names that could make model text mean something
  -- other than the library says, and instances (library issue L20)
  let opened : Array Name := #[@OPENS@]
  -- the library's namespaces: the prefixes of its constants
  let mut tvaNs : NameSet := {}
  for (n, _) in env.constants.map₁.toList do
    if n.getRoot == `TVA then
      let mut p := n.getPrefix
      while !p.isAnonymous do
        tvaNs := tvaNs.insert p
        p := p.getPrefix
  let endsWith (a b : Name) : Bool := a.components.reverse.take b.components.length == b.components.reverse
  -- what a name the kernel writes could otherwise mean: a constant through `TVA`, through any
  -- namespace whose name ends with one the kernel's files `open` (read by tvr over every line of the
  -- command; Lean resolves `open X` against the namespaces opened before it), or at the root (a
  -- constant or an alias such as `min`, which is `Min.min`)
  let mut opens : Array Name := #[`TVA]
  for o in env.getNamespaces do
    if opened.any (fun x => endsWith o x) && !opens.contains o then opens := opens.push o
  -- the names Lean generates for a structure or inductive type the kernel declares
  let auto : List String := ["mk", "rec", "casesOn", "recOn", "noConfusion", "noConfusionType", "brecOn",
    "below", "binductionOn", "ibelow", "eq_def", "inj", "injEq", "sizeOf_spec", "ext", "ext_iff", "ctorIdx",
    "toCtorIdx", "ctorElim", "ctorElimType"]
  let mut shadow : Array String := #[]
  let mut insts : Array Json := #[]
  let mut binders : Array Json := #[]
  let mut kconsts : Array Name := #[]
  for i in [0:env.header.moduleNames.size] do
    if (`@PREFIX@).isPrefixOf env.header.moduleNames[i]! then
      kconsts := kconsts ++ env.header.moduleData[i]!.constNames
  for n in kconsts do
    let some ci := env.find? n | continue
    -- a private declaration is checked under the name the kernel wrote
    let un := (privateToUserName? n).getD n
    let comps := un.components
    let last := (comps.getLast?.map (·.toString)).getD ""
    let numbered (pre : String) : Bool :=
      last.startsWith pre && last.length > pre.length && (last.drop pre.length).all Char.isDigit
    -- an equation lemma Lean generates when the kernel's proof unfolds a definition
    -- (`TVA.Launch.ctx.eq_1`): a reserved name, which no declaration can take
    let eqnLemma := ci matches .thmInfo _ && (numbered "eq_" || last == "eq_def" || last == "eq_unfold") &&
      env.contains un.getPrefix
    -- generated: by its kind (a constructor, a recursor, a matcher), an internal name, or a name of
    -- the `auto` list whose prefix is a structure or inductive type (or its constructor) that the
    -- kernel's modules declare. A definition the kernel writes is never generated, whatever its name
    -- (`def Launch.mk` is checked, library issue L20).
    let preOwn := TVR.kernelModule env n.getPrefix && (match env.find? n.getPrefix with
      | some (.inductInfo _) => true | some (.ctorInfo _) => true | _ => false)
    let generated := un.isInternal || eqnLemma || ci matches .ctorInfo _ || ci matches .recInfo _ ||
      isMatcherCore env n || (auto.contains last && preOwn)
    if un.getRoot == `TVA then
      if !eqnLemma then shadow := shadow.push s!"{un} (declared in the library's namespace)"
    else if !(ns.isPrefixOf un) && !(TVR.leanMade un) then
      -- only names Lean makes (a numeric component) are exempt, not a user-written `_x` (L63)
      shadow := shadow.push s!"{un} (declared outside the kernel's namespace {ns})"
    if !eqnLemma && comps.any (TVR.compStr · == "tl") then
      shadow := shadow.push s!"{un} (a name with a component `tl`, the namespace of the library's operations)"
    else if !generated then
      if !(comps.all fun c => TVR.plainComponent (TVR.compStr c)) then
        shadow := shadow.push s!"{un} (a name with a character other than ASCII letters, digits, `_`, `'`, `!` and `?`, which can look like another name)"
      -- a suffix of the name, as the kernel may write it, that would otherwise mean another constant
      for k in [1:comps.length + 1] do
        let s := Name.fromComponents (comps.drop (comps.length - k))
        for o in opens do
          if env.contains (o ++ s) && o ++ s != un then
            shadow := shadow.push s!"{un} (written `{s}`, it can be read as `{o ++ s}`)"
        if env.contains s && s != un then
          shadow := shadow.push s!"{un} (written `{s}`, it can be read as the root's `{s}`)"
        for a in getAliases env s false do
          shadow := shadow.push s!"{un} (written `{s}`, it can be read as `{a}`, which `{s}` names at the root)"
    if ← isInstance n then
      let cls ← forallTelescope ci.type fun _ b => pure (b.getAppFn.constName?.getD Name.anonymous)
      -- the one instance Lean makes for a type the kernel declares: its `SizeOf` instance
      -- `<type>._sizeOf_inst`; any other instance, a user-written `_x` included, is the kernel's
      -- (library issue L63)
      let made := last == "_sizeOf_inst" && cls == ``SizeOf && TVR.kernelModule env n.getPrefix &&
        (env.find? n.getPrefix matches some (.inductInfo _))
      insts := insts.push (Json.mkObj [("name", toJson n.toString), ("class", toJson cls.toString),
        ("internal", toJson made)])
    -- the binders of the kernel's definitions and types (not of its proofs): a binder named `tl`
    -- makes `tl.add` a field of it (library issue L20); tvr compares them with the library's names
    let exprs : Array Expr := match ci with
      | .defnInfo v => #[v.type, v.value]
      | .opaqueInfo v => #[v.type]
      | .inductInfo v => #[v.type]
      | .ctorInfo v => #[v.type]
      | _ => #[]
    if !exprs.isEmpty then
      let ((), (_, bs)) := (exprs.forM TVR.binderNames).run ({}, {})
      for b in bs.toArray do
        binders := binders.push (Json.arr #[toJson un.toString, toJson (b.toString (escape := false))])
  -- the library's names a binder may not take: its namespaces that are not definitions (`tl`,
  -- `Tensor`, `Block`, …), by their last component
  let mut libNames : NameSet := {}
  for p in tvaNs.toArray do
    match env.find? p with
    | none | some (.inductInfo _) =>
      if let some c := p.components.getLast? then libNames := libNames.insert c
    | _ => pure ()
  -- the fields' types, pretty-printed
  let mut ftypes : Array (String × Json) := #[]
  let mut fdocs : Array (String × Json) := #[]
  -- what each statement mentions: its TVA and kernel constants, and the parameters `K`, `P`; its
  -- shape; and its canonical text
  let mut fuses : Array (String × Json) := #[]
  for f in fields do
    let some ci := env.find? (ns ++ `Assumptions ++ f) | continue
    let s ← forallBoundedTelescope ci.type (some (npar + 1)) fun _ b => do return toString (← ppExpr b)
    ftypes := ftypes.push (f.toString, toJson s)
    fdocs := fdocs.push (f.toString, toJson ((← findDocString? env (ns ++ `Assumptions ++ f)).getD ""))
    let u ← forallBoundedTelescope ci.type (some (npar + 1)) fun xs b => do
      let cs := (b.getUsedConstants.filter (TVR.inScope env)).map (·.toString)
      let mentions (i : Nat) : Bool := match xs[i]? with
        | some x => b.containsFVar x.fvarId!
        | none => false
      -- the statement's shape (library issue L62): under its `∀` and `→` binders, the constant it
      -- applies, whether that constant's type is `Platform → Prop` (a fact with its constants in its
      -- definition), and each argument: the platform `P` itself; a constant alone (`.binary64`), with
      -- the head constant of its type (`TVA.Format`, for dot notation); a function applied to one
      -- variable the statement binds (`model d`, `K d`): the function (a constant's name, or `K`) and
      -- the variable's place among the statement's binders (-1 for anything else); and the argument
      -- as Lean prints it
      let shape ← forallTelescope b fun ys body => do
        let fn := body.getAppFn
        let head := match fn with | .const n _ => n.toString | _ => ""
        let fact := match fn with
          | .const n _ => match env.find? n with
            | some c => match c.type with
              | .forallE _ (.const p []) (.sort .zero) _ => p == ``TVA.Platform
              | _ => false
            | none => false
          | _ => false
        let mut args : Array Json := #[]
        for a in body.getAppArgs do
          let f := a.getAppFn
          let one := a.getAppArgs.size == 1
          let fnName := if !one then "" else match f with
            | .const n _ => n.toString
            | .fvar _ => if xs[0]? == some f then "K" else ""
            | _ => ""
          let var : Int := if !one then -1 else
            match ys.findIdx? (· == a.getAppArgs[0]!) with
            | some i => (i : Int)
            | none => -1
          let ty ← try pure (((← inferType a).getAppFn.constName?.map (·.toString)).getD "") catch _ => pure ""
          args := args.push (Json.mkObj [
            ("platform", toJson (match xs[1]? with | some x => a == x | none => false)),
            ("const", toJson (match a with | .const n _ => n.toString | _ => "")),
            ("type", toJson ty), ("fn", toJson fnName), ("var", toJson var),
            ("pp", toJson (toString (← ppExpr a)))])
        return (head, fact, args)
      return Json.mkObj [("consts", toJson cs), ("K", toJson (mentions 0)), ("P", toJson (mentions 1)),
        ("head", toJson shape.1), ("platform_fact", toJson shape.2.1), ("args", Json.arr shape.2.2),
        -- the statement itself, as canonical text with `K` and `P` bound (the projection's type), which
        -- tvr hashes into the field's item (library issue L68)
        ("canon", toJson (TVR.canonExpr ci.type ""))]
    fuses := fuses.push (f.toString, u)
  let mainTy : String ← match env.find? (ns ++ `main) with
    | some ci => do pure (toString (← ppExpr ci.type))
    | none => pure ""
  let out := Json.mkObj [("items", Json.mkObj itemJs.toList), ("consts", toJson consts),
    ("fields", toJson (fields.map (·.toString))), ("field_types", Json.mkObj ftypes.toList),
    ("field_docs", Json.mkObj fdocs.toList), ("field_uses", Json.mkObj fuses.toList),
    ("usage", Json.mkObj usage.toList), ("destructured", toJson destructured),
    ("axioms", Json.mkObj [("main", toJson (axMain.map (·.toString))),
      ("consistent", toJson (axCons.map (·.toString))),
      ("satisfiable", toJson (axSat.map (·.toString)))]),
    ("shadow", toJson shadow), ("instances", toJson insts), ("main_type", toJson mainTy),
    ("binders", toJson binders), ("library_names", toJson (libNames.toArray.map (·.toString))),
    ("lean", toJson Lean.versionString)]
  IO.println s!"TVR_JSON {out.compress}"
