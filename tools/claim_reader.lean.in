import Lean
import @MODULE@

/-! Generated by `tools/tvr.py check`; do not edit. The claim reader of TVA's review protocol
(`docs/REVIEW_PROTOCOL.md`). It reads the prover's elaborated Lean claim, never the kernel's
source: there is no translator, and the model is the prover's transcription. The `example`s fail
to elaborate when the claim does not have the protocol's shape; the `#eval` prints one JSON
object (line prefix `TVR_JSON `) with each item's constants, their hashes and docstrings, the
axioms of `main` and `consistent`, and how `main` uses each assumption. -/

open Lean Meta

/-! ## The claim's shape -/

example : ∀ (K : TVA.Claim.Behaviour @NS@.Inst) (P : TVA.Platform), @NS@.Assumptions K P → @NS@.Spec K :=
  @NS@.main
example : TVA.Claim.Consistent @NS@.Assumptions := @NS@.consistent
example : ∀ K, @NS@.Spec K = TVA.Claim.Meets @NS@.Inst.ok @NS@.Pre @NS@.Post K := fun _ => rfl

/-! ## What the claim mentions -/

namespace TVR

def inScope (n : Name) : Bool := n.getRoot == `TVA || n.getRoot == `TVAExamples

/-- The constants an item reaches: definitions are followed through their values, theorems,
axioms and opaque constants through their types only (a proof is not part of the meaning). -/
def cone (roots : Array Name) : MetaM (Array Name) := do
  let env ← getEnv
  let mut seen : NameSet := {}
  let mut out : Array Name := #[]
  let mut stack : Array Name := roots
  while h : stack.size > 0 do
    let n := stack[stack.size - 1]
    stack := stack.pop
    if seen.contains n then continue
    seen := seen.insert n
    let some ci := env.find? n | continue
    out := out.push n
    let mut used := ci.type.getUsedConstants
    match ci with
    | .defnInfo v => used := used ++ v.value.getUsedConstants
    | .inductInfo v => used := used ++ v.ctors.toArray
    | .ctorInfo v => used := used.push v.induct
    | _ => pure ()
    for m in used do
      if inScope m && !seen.contains m then stack := stack.push m
  return out

/-- The constants a theorem's proof reaches inside the bundle's namespace (for assumption usage). -/
def proofCone (root : Name) (ns : Name) : MetaM NameSet := do
  let env ← getEnv
  let mut seen : NameSet := {}
  let mut stack : Array Name := #[root]
  while h : stack.size > 0 do
    let n := stack[stack.size - 1]
    stack := stack.pop
    if seen.contains n then continue
    seen := seen.insert n
    let some ci := env.find? n | continue
    let mut used := ci.type.getUsedConstants
    if let some v := ci.value? (allowOpaque := true) then used := used ++ v.getUsedConstants
    for m in used do
      if ns.isPrefixOf m && !seen.contains m then stack := stack.push m
      else seen := seen.insert m
  return seen

def kindOf : ConstantInfo → String
  | .defnInfo _ => "def" | .thmInfo _ => "theorem" | .axiomInfo _ => "axiom"
  | .opaqueInfo _ => "opaque" | .inductInfo _ => "inductive" | .ctorInfo _ => "ctor"
  | .recInfo _ => "rec" | .quotInfo _ => "quot"

def constJson (n : Name) : MetaM Json := do
  let env ← getEnv
  let some ci := env.find? n | return Json.null
  let vh : UInt64 := match ci with
    | .defnInfo v => mixHash v.value.hash (hash (toString v.value))
    | _ => 0
  let th := mixHash ci.type.hash (hash (toString ci.type))
  let doc ← findDocString? env n
  let rng ← findDeclarationRanges? n
  let modName := match env.getModuleIdxFor? n with
    | some i => (env.header.moduleNames[i.toNat]!).toString
    | none => ""
  let rj : Json := match rng with
    | some r => Json.arr #[toJson r.range.pos.line, toJson r.range.endPos.line]
    | none => Json.null
  return Json.mkObj [("name", toJson n.toString), ("kind", toJson (kindOf ci)),
    ("module", toJson modName), ("hash", toJson s!"{th}-{vh}"), ("range", rj),
    ("doc", match doc with | some d => toJson d | none => Json.null)]

end TVR

#eval show MetaM Unit from do
  let env ← getEnv
  let ns : Name := `@NS@
  let items : List (String × Array Name) := [
    ("model", #[ns ++ `model, ns ++ `launch]),
    ("conditions", #[ns ++ `Inst, ns ++ `Inst.ok, ns ++ `Pre]),
    ("spec", #[ns ++ `Post, ns ++ `Spec])]
  let fields := getStructureFields env (ns ++ `Assumptions)
  let npar ← match env.find? (ns ++ `Assumptions) with
    | some (.inductInfo v) => pure v.numParams
    | _ => throwError "Assumptions is not a structure"
  -- an assumption's roots: the constants its statement (the field's type) mentions
  let mut fitems : List (String × Array Name) := []
  for f in fields do
    let some ci := env.find? (ns ++ `Assumptions ++ f) | continue
    let roots ← forallBoundedTelescope ci.type (some (npar + 1)) fun _ b =>
      pure ((b.getUsedConstants.filter TVR.inScope).push (ns ++ `Inst))
    fitems := fitems ++ [(s!"assumption:{f}", roots)]
  let items := items ++ fitems
  let mut itemJs : Array (String × Json) := #[]
  let mut all : NameSet := {}
  for (it, roots) in items do
    let c ← TVR.cone roots
    for n in c do all := all.insert n
    itemJs := itemJs.push (it, Json.mkObj [("roots", toJson (roots.map (·.toString))),
      ("cone", toJson (c.map (·.toString)))])
  let mut consts : Array Json := #[]
  for n in all.toArray do consts := consts.push (← TVR.constJson n)
  -- assumption usage by `main`
  let used ← TVR.proofCone (ns ++ `main) ns
  let mut usage : Array (String × Json) := #[]
  for f in fields do
    usage := usage.push (f.toString, toJson (used.contains (ns ++ `Assumptions ++ f)))
  let destructured := used.contains (ns ++ `Assumptions.casesOn) || used.contains (ns ++ `Assumptions.rec)
  -- axioms
  let axMain ← collectAxioms (ns ++ `main)
  let axCons ← collectAxioms (ns ++ `consistent)
  -- constants declared by the bundle's modules: shadowing and instances
  let mut shadow : Array String := #[]
  let mut insts : Array Json := #[]
  for (n, ci) in env.constants.map₂.toList do
    let some i := env.getModuleIdxFor? n | continue
    let m := env.header.moduleNames[i.toNat]!
    if !(`@PREFIX@).isPrefixOf m then continue
    if n.getRoot == `TVA then shadow := shadow.push n.toString
    if ← isInstance n then
      let cls ← forallTelescope ci.type fun _ b => pure (b.getAppFn.constName?.getD Name.anonymous)
      insts := insts.push (Json.mkObj [("name", toJson n.toString), ("class", toJson cls.toString)])
  -- the fields' types, pretty-printed
  let mut ftypes : Array (String × Json) := #[]
  let mut fdocs : Array (String × Json) := #[]
  -- what each statement mentions: its TVA and kernel constants, and the parameters `K`, `P`
  let mut fuses : Array (String × Json) := #[]
  for f in fields do
    let some ci := env.find? (ns ++ `Assumptions ++ f) | continue
    let s ← forallBoundedTelescope ci.type (some (npar + 1)) fun _ b => do return toString (← ppExpr b)
    ftypes := ftypes.push (f.toString, toJson s)
    fdocs := fdocs.push (f.toString, toJson ((← findDocString? env (ns ++ `Assumptions ++ f)).getD ""))
    let u ← forallBoundedTelescope ci.type (some (npar + 1)) fun xs b => do
      let cs := (b.getUsedConstants.filter TVR.inScope).map (·.toString)
      let mentions (i : Nat) : Bool := match xs[i]? with
        | some x => b.containsFVar x.fvarId!
        | none => false
      return Json.mkObj [("consts", toJson cs), ("K", toJson (mentions 0)), ("P", toJson (mentions 1))]
    fuses := fuses.push (f.toString, u)
  let mainTy : String ← match env.find? (ns ++ `main) with
    | some ci => do pure (toString (← ppExpr ci.type))
    | none => pure ""
  let out := Json.mkObj [("items", Json.mkObj itemJs.toList), ("consts", toJson consts),
    ("fields", toJson (fields.map (·.toString))), ("field_types", Json.mkObj ftypes.toList),
    ("field_docs", Json.mkObj fdocs.toList), ("field_uses", Json.mkObj fuses.toList),
    ("usage", Json.mkObj usage.toList), ("destructured", toJson destructured),
    ("axioms", Json.mkObj [("main", toJson (axMain.map (·.toString))),
      ("consistent", toJson (axCons.map (·.toString)))]),
    ("shadow", toJson shadow), ("instances", toJson insts), ("main_type", toJson mainTy),
    ("lean", toJson Lean.versionString)]
  IO.println s!"TVR_JSON {out.compress}"
