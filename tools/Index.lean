import TVA
import TVA.Proof
open Lean Elab Command Meta

/-! Dump every declaration of the `TVA` library as JSON, for `tools/make_index.py`: its name,
kind, module, source line, signature and docstring. Generated declarations (equation lemmas,
recursors, matchers, private names) are left out. The output path is `$TVA_INDEX_OUT`. -/

/-- Whether a declaration name is generated by Lean rather than written in the library. -/
def generated (env : Environment) (n : Name) : Bool :=
  n.isInternal || isAuxRecursor env n || isNoConfusion env n || isMatcherCore env n ||
  (match n with
   | .str _ s => s ∈ ["eq_def", "inj", "injEq", "sizeOf_spec", "ctorIdx", "induct", "mutual_induct",
                      "rec", "recOn", "casesOn", "below", "brecOn", "binductionOn", "ibelow"] ||
                 s.startsWith "eq_" || s.startsWith "proof_" || s.startsWith "match_" ||
                 s.startsWith "_"
   | _ => false)

run_cmd do
  let env ← getEnv
  let mut out : Array Json := #[]
  for (n, ci) in env.constants.map₁.toList do
    let some idx := env.getModuleIdxFor? n | continue
    let mod := env.header.moduleNames[idx.toNat]!
    unless (`TVA).isPrefixOf mod do continue
    if generated env n then continue
    let kind := match ci with
      | .thmInfo _ => "theorem" | .defnInfo _ => "def" | .axiomInfo _ => "axiom"
      | .inductInfo _ => "inductive" | .ctorInfo _ => "constructor" | .opaqueInfo _ => "opaque"
      | .recInfo _ => "recursor" | .quotInfo _ => "quot"
    let kind := if isStructure env n then "structure" else if isClass env n then "class" else kind
    let line ← match (← liftCoreM (findDeclarationRanges? n)) with
      | some r => pure r.range.pos.line
      | none => pure 0
    let sig ← liftTermElabM do
      withOptions (fun o => (o.set `format.width (100 : Nat)).set `pp.proofs false) do
        return toString (← PrettyPrinter.ppSignature n).fmt
    let doc := (← findDocString? env n).getD ""
    out := out.push <| Json.mkObj [("name", toString n), ("kind", kind), ("module", toString mod),
      ("line", line), ("sig", sig), ("doc", doc)]
  let path := (← IO.getEnv "TVA_INDEX_OUT").getD "index.json"
  IO.FS.writeFile path (Json.arr out).compress
  logInfo m!"wrote {out.size} declarations to {path}"
