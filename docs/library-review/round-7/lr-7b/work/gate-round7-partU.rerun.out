  3: round 6 ---- | round 7 code |     x = tl.load(x_ptr)  # """
  4: round 6 ---- | round 7 code |     tl.atomic_add(c, 1)
  5: round 6 ---- | round 7 code |     tl.store(x_ptr, x)  # """
